---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Verdant — The Finest. Naturally.',
  description = "Pietermaritzburg's first premium cannabis dispensary. Curated flower, vapes, edibles, tinctures and accessories. 18 Church Street, PMB. Open Mon–Sat 09:00–19:00.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#080C08" />
    <title>{title}</title>

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Google Fonts — preconnect for speed -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500;1,600&family=Jost:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Styles injected via Astro frontmatter import -->
  </head>
  <body>
    <slot />

    <!-- ============================================================
         GLOBAL JAVASCRIPT — is:inline bypasses Astro bundling,
         runs directly as a classic script after body parses
         ============================================================ -->
    <script is:inline>
      document.addEventListener('DOMContentLoaded', function () {

        // ── AGE GATE ────────────────────────────────────────────
        var gate       = document.getElementById('age-gate');
        var ageContent = document.getElementById('age-content');
        var rejected   = document.getElementById('age-rejected');
        var confirmBtn = document.getElementById('age-confirm');
        var denyBtn    = document.getElementById('age-deny');

        function triggerHero() {
          document.querySelectorAll('.hero-line').forEach(function(el) {
            el.classList.add('animated');
          });
        }

        if (gate) {
          if (sessionStorage.getItem('vrd-age-verified') === '1') {
            gate.classList.add('gone');
            setTimeout(triggerHero, 80);
          } else {
            if (confirmBtn) {
              confirmBtn.addEventListener('click', function () {
                sessionStorage.setItem('vrd-age-verified', '1');
                gate.classList.add('fade-out');
                setTimeout(function () { gate.classList.add('gone'); }, 950);
                setTimeout(triggerHero, 200);
              });
            }
            if (denyBtn) {
              denyBtn.addEventListener('click', function () {
                if (ageContent) ageContent.classList.add('hidden');
                if (rejected)   rejected.classList.add('visible');
              });
            }
          }
        }

        // ── NAV SCROLL ──────────────────────────────────────────
        var nav = document.getElementById('main-nav');
        if (nav) {
          function onScroll() {
            if (window.scrollY > 60) {
              nav.classList.add('scrolled');
            } else {
              nav.classList.remove('scrolled');
            }
          }
          window.addEventListener('scroll', onScroll, { passive: true });
          onScroll();
        }

        // ── MOBILE MENU ─────────────────────────────────────────
        var burger   = document.getElementById('burger');
        var closeBtn = document.getElementById('menu-close');
        var mobileMenu = document.getElementById('mobile-menu');

        if (burger && mobileMenu) {
          function openMenu()  { mobileMenu.classList.add('open');    document.body.style.overflow = 'hidden'; }
          function closeMenu() { mobileMenu.classList.remove('open'); document.body.style.overflow = ''; }

          burger.addEventListener('click', openMenu);
          if (closeBtn) closeBtn.addEventListener('click', closeMenu);
          mobileMenu.querySelectorAll('a').forEach(function(l) {
            l.addEventListener('click', closeMenu);
          });
        }

        // ── CATEGORY FILTER ─────────────────────────────────────
        var pills = document.querySelectorAll('.cat-pill');
        var cards = document.querySelectorAll('.product-card-wrap');

        pills.forEach(function(pill) {
          pill.addEventListener('click', function () {
            pills.forEach(function(p) { p.classList.remove('active'); });
            pill.classList.add('active');

            var cat = pill.dataset.cat || 'ALL';
            cards.forEach(function(card) {
              if (cat === 'ALL' || card.dataset.category === cat) {
                card.classList.remove('hidden-product');
              } else {
                card.classList.add('hidden-product');
              }
            });
          });
        });

        // ── SCROLL ANIMATIONS ───────────────────────────────────
        var animEls = document.querySelectorAll('[data-animate]');

        if (!animEls.length) return;

        if (!('IntersectionObserver' in window)) {
          // Fallback: show all immediately
          animEls.forEach(function(el) { el.classList.add('animated'); });
          return;
        }

        var io = new IntersectionObserver(function(entries) {
          entries.forEach(function(e) {
            if (e.isIntersecting) {
              e.target.classList.add('animated');
              io.unobserve(e.target);
            }
          });
        }, { threshold: 0.08, rootMargin: '0px 0px -30px 0px' });

        animEls.forEach(function(el) { io.observe(el); });

        // Safety fallback: force-reveal anything still hidden after 3s
        setTimeout(function() {
          animEls.forEach(function(el) {
            if (!el.classList.contains('animated')) {
              el.classList.add('animated');
            }
          });
        }, 3000);

      }); // end DOMContentLoaded
    </script>
  </body>
</html>
