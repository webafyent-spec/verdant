---
// Navigation — fixed, transparent, split-text hover, mobile overlay
const links = ['Products','Strains','About','Visit'];
---

<!-- Mobile Menu -->
<div id="mobile-menu" role="dialog" aria-modal="true" aria-label="Navigation">
  <button id="menu-close" aria-label="Close menu" style="position:absolute;top:1.5rem;right:1.5rem;background:none;border:none;cursor:pointer;color:#FFFFFF;padding:0.5rem;z-index:10;">
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
      <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
    </svg>
  </button>
  <!-- offset first child stagger -->
  <span style="display:none;"></span>
  {links.map((l) => (
    <a href={`#${l.toLowerCase()}`} class="mobile-nav-link">{l}</a>
  ))}
  <div style="position:absolute;bottom:3rem;left:3rem;">
    <div style="font-family:'Space Grotesk',sans-serif;font-size:0.72rem;color:#8B949E;letter-spacing:0.1em;text-transform:uppercase;margin-bottom:0.5rem;">PMB · 18+ Only</div>
    <div style="font-family:'Space Grotesk',sans-serif;font-size:0.9rem;font-weight:700;color:#00C896;">hello@verdant.co.za</div>
  </div>
</div>

<!-- Main Nav -->
<nav id="main-nav" aria-label="Main navigation">
  <!-- Logo -->
  <a href="#home" style="text-decoration:none;display:flex;align-items:baseline;gap:0.1rem;flex-shrink:0;" aria-label="Verdant home">
    <span style="font-family:'Space Grotesk',sans-serif;font-size:2.2rem;font-weight:700;color:#00C896;letter-spacing:-0.04em;line-height:1;">V</span>
    <span style="font-family:'Space Grotesk',sans-serif;font-size:1.125rem;font-weight:700;color:#FFFFFF;letter-spacing:-0.03em;line-height:1;">ERDANT</span>
  </a>

  <!-- Desktop links (right side) -->
  <div style="display:flex;align-items:center;gap:2.5rem;" class="hide-mobile">
    {links.map((l) => (
      <a href={`#${l.toLowerCase()}`} class="nav-link" aria-label={l}>
        <span class="nav-link-inner">
          <span class="nav-link-text">{l}</span>
          <span class="nav-link-hover">{l}</span>
        </span>
      </a>
    ))}
    <div class="badge-18" aria-label="Adults 18 and older only">18+</div>
  </div>

  <!-- Mobile controls -->
  <div style="display:flex;align-items:center;gap:1rem;" class="hide-desktop">
    <div class="badge-18">18+</div>
    <button id="burger" aria-label="Open navigation" style="background:none;border:none;cursor:pointer;color:#FFFFFF;padding:0.25rem;display:flex;align-items:center;">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
        <line x1="3" y1="6" x2="21" y2="6"/>
        <line x1="3" y1="12" x2="21" y2="12"/>
        <line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
    </button>
  </div>
</nav>

<style>
  @media (max-width: 768px) { .hide-mobile { display: none !important; } }
  @media (min-width: 769px) { .hide-desktop { display: none !important; } }
</style>
