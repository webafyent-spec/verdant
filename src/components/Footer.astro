---
// Footer — single row layout, minimal and clean
---

<footer style="background:#06080A;border-top:1px solid #00C896;">

  <!-- Main row -->
  <div style="max-width:1400px;margin:0 auto;padding:3rem 2rem;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:2rem;" id="footer-grid">

    <!-- Left — brand -->
    <div>
      <div style="display:flex;align-items:baseline;gap:0.1rem;margin-bottom:0.5rem;">
        <span style="font-family:'Space Grotesk',sans-serif;font-size:2rem;font-weight:700;color:#00C896;letter-spacing:-0.04em;line-height:1;">V</span>
        <span style="font-family:'Space Grotesk',sans-serif;font-size:1.125rem;font-weight:700;color:#FFFFFF;letter-spacing:-0.03em;line-height:1;">ERDANT</span>
      </div>
      <p style="font-family:'Space Grotesk',sans-serif;font-size:0.68rem;font-weight:700;letter-spacing:0.14em;color:#00C896;text-transform:uppercase;">
        PMB · 18+ Only
      </p>
    </div>

    <!-- Center — nav links -->
    <nav aria-label="Footer navigation" style="display:flex;gap:2rem;align-items:center;flex-wrap:wrap;justify-content:center;">
      <a href="#products"  class="footer-link">Products</a>
      <a href="#strains"   class="footer-link">Strains</a>
      <a href="#about"     class="footer-link">About</a>
      <a href="#visit"     class="footer-link">Visit</a>
    </nav>

    <!-- Right — contact -->
    <div style="text-align:right;">
      <a href="mailto:hello@verdant.co.za" style="font-family:'Space Grotesk',sans-serif;font-size:0.875rem;font-weight:600;color:#FFFFFF;text-decoration:none;display:block;margin-bottom:0.25rem;transition:color 0.25s;" onmouseover="this.style.color='#00C896'" onmouseout="this.style.color='#FFFFFF'">
        hello@verdant.co.za
      </a>
      <a href="tel:0333420180" style="font-family:'Space Grotesk',sans-serif;font-size:0.875rem;font-weight:600;color:#FFFFFF;text-decoration:none;display:block;transition:color 0.25s;" onmouseover="this.style.color='#00C896'" onmouseout="this.style.color='#FFFFFF'">
        033 342 0180
      </a>
    </div>
  </div>

  <!-- Legal micro bar -->
  <div style="border-top:1px solid rgba(255,255,255,0.05);padding:1.25rem 2rem;">
    <div style="max-width:1400px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:0.75rem;">
      <span style="font-family:'Space Grotesk',sans-serif;font-size:0.65rem;color:rgba(139,148,158,0.45);letter-spacing:0.06em;">
        © 2026 Verdant. For adults 18+ only. Consume responsibly.
      </span>
      <a href="https://webafy.co.za" target="_blank" rel="noopener noreferrer" style="font-family:'Space Grotesk',sans-serif;font-size:0.65rem;color:#00C896;text-decoration:none;letter-spacing:0.08em;opacity:0.6;transition:opacity 0.25s;" onmouseover="this.style.opacity='1'" onmouseout="this.style.opacity='0.6'">
        Website by Webafy — webafy.co.za
      </a>
    </div>
  </div>
</footer>

<style>
  @media (max-width: 768px) {
    #footer-grid {
      grid-template-columns: 1fr !important;
      text-align: center !important;
      gap: 1.5rem !important;
    }
    #footer-grid > div:last-child { text-align: center !important; }
  }
</style>
