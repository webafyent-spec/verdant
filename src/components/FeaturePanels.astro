---
// Section 4 — Full-width three-panel feature: botanical, photography, tagline
---

<!-- Top wave divider -->
<div class="wave-divider" aria-hidden="true">
  <svg viewBox="0 0 1440 56" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M0,0 C360,56 1080,0 1440,56 L1440,0 L0,0Z" fill="#0D140D"/>
  </svg>
</div>

<div class="feature-panels" aria-label="Verdant values">

  <!-- Panel 1 — Deep green botanical -->
  <div style="background-color:#1B4332;padding:5rem 3.5rem;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;min-height:520px;position:relative;overflow:hidden;">

    <!-- Large botanical leaf SVG filling panel -->
    <div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;opacity:0.22;" aria-hidden="true">
      <svg viewBox="0 0 120 160" fill="none" xmlns="http://www.w3.org/2000/svg" width="65%" height="auto">
        <g stroke="#C9A84C" stroke-width="0.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M60 155 C60 155 58 133 60 115"/>
          <path d="M60 115 C55 95 48 75 46 52 C50 62 55 78 57 88 C54 72 53 48 60 30 C67 48 66 72 63 88 C65 78 70 62 74 52 C72 75 65 95 60 115Z"/>
          <path d="M56 100 C48 92 32 86 18 80 C27 86 40 92 52 100Z"/>
          <path d="M64 100 C72 92 88 86 102 80 C93 86 80 92 68 100Z"/>
          <path d="M53 108 C43 102 26 104 12 101 C22 106 36 108 50 110Z"/>
          <path d="M67 108 C77 102 94 104 108 101 C98 106 84 108 70 110Z"/>
          <path d="M52 112 C42 110 28 115 16 115 C25 118 38 117 54 115Z"/>
          <path d="M68 112 C78 110 92 115 104 115 C95 118 82 117 66 115Z"/>
        </g>
      </svg>
    </div>

    <!-- Gold horizontal accent line -->
    <div style="width:40px;height:1px;background:#C9A84C;margin:0 auto 1.25rem;position:relative;z-index:2;"></div>

    <!-- Text content at bottom of panel -->
    <div style="text-align:center;position:relative;z-index:2;">
      <h3 style="font-family:'Cormorant Garamond',Georgia,serif;font-size:2.5rem;font-style:italic;font-weight:400;color:#F5F0E8;margin:0 0 0.75rem;line-height:1.1;">
        Hand-selected.
      </h3>
      <p style="font-family:'Jost',sans-serif;font-size:0.8rem;color:rgba(245,240,232,0.65);letter-spacing:0.06em;line-height:1.6;margin:0;">
        Every cultivar chosen by our team.<br />No exceptions.
      </p>
    </div>
  </div>

  <!-- Panel 2 — Dark product photography -->
  <div class="grain" style="background-color:#080C08;padding:4rem 3rem;display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:520px;position:relative;overflow:hidden;">

    <!-- Subtle radial glow -->
    <div style="position:absolute;inset:0;background:radial-gradient(ellipse at 50% 50%, rgba(201,168,76,0.05) 0%, transparent 65%);pointer-events:none;" aria-hidden="true"></div>

    <!-- Product photography placeholder — organic blob shape -->
    <div style="
      width:260px;
      height:320px;
      border-radius: 52% 48% 65% 35% / 42% 58% 42% 58%;
      border:1px solid rgba(201,168,76,0.35);
      background:linear-gradient(155deg, #111A11 0%, #080C08 100%);
      display:flex;
      align-items:center;
      justify-content:center;
      position:relative;
      z-index:2;
      overflow:hidden;
    " role="img" aria-label="Product photography placeholder">
      <!-- Inner glow -->
      <div style="position:absolute;inset:0;background:radial-gradient(ellipse at 50% 40%, rgba(201,168,76,0.08) 0%, transparent 65%);"></div>
      <div style="text-align:center;padding:2rem;position:relative;z-index:2;">
        <!-- Small leaf icon -->
        <svg viewBox="0 0 120 160" fill="none" xmlns="http://www.w3.org/2000/svg" width="40" height="54" style="margin:0 auto 1rem;display:block;" aria-hidden="true">
          <g stroke="#C9A84C" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M60 155 C60 155 58 133 60 115"/>
            <path d="M60 115 C55 95 48 75 46 52 C50 62 55 78 57 88 C54 72 53 48 60 30 C67 48 66 72 63 88 C65 78 70 62 74 52 C72 75 65 95 60 115Z"/>
            <path d="M56 100 C48 92 32 86 18 80 C27 86 40 92 52 100Z"/>
            <path d="M64 100 C72 92 88 86 102 80 C93 86 80 92 68 100Z"/>
          </g>
        </svg>
        <span style="font-family:'Cormorant Garamond',Georgia,serif;font-size:1rem;font-style:italic;color:#C9A84C;display:block;line-height:1.4;opacity:0.8;">Product<br />Photography</span>
      </div>
    </div>

    <!-- Bottom label -->
    <p style="font-family:'Jost',sans-serif;font-size:0.68rem;color:rgba(157,184,160,0.5);letter-spacing:0.16em;text-transform:uppercase;margin-top:2rem;position:relative;z-index:2;">
      Verdant Collection 2024
    </p>
  </div>

  <!-- Panel 3 — Gold tagline panel -->
  <div style="background-color:#C9A84C;padding:5rem 3.5rem;display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:520px;position:relative;overflow:hidden;">

    <!-- Subtle noise on gold -->
    <div style="position:absolute;inset:0;opacity:0.06;background-image:url(data:image/svg+xml,%3Csvg%20xmlns%3D'http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg'%20width%3D'200'%20height%3D'200'%3E%3Cfilter%20id%3D'n'%3E%3CfeTurbulence%20type%3D'fractalNoise'%20baseFrequency%3D'0.85'%20numOctaves%3D'4'%20stitchTiles%3D'stitch'%2F%3E%3C%2Ffilter%3E%3Crect%20width%3D'200'%20height%3D'200'%20filter%3D'url(%23n)'%2F%3E%3C%2Fsvg%3E);pointer-events:none;" aria-hidden="true"></div>

    <!-- Thin botanical outline in background -->
    <div style="position:absolute;bottom:-40px;right:-40px;opacity:0.08;" aria-hidden="true">
      <svg viewBox="0 0 120 160" fill="none" xmlns="http://www.w3.org/2000/svg" width="200" height="260">
        <g stroke="#080C08" stroke-width="0.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M60 155 C60 155 58 133 60 115"/>
          <path d="M60 115 C55 95 48 75 46 52 C50 62 55 78 57 88 C54 72 53 48 60 30 C67 48 66 72 63 88 C65 78 70 62 74 52 C72 75 65 95 60 115Z"/>
          <path d="M56 100 C48 92 32 86 18 80 C27 86 40 92 52 100Z"/>
          <path d="M64 100 C72 92 88 86 102 80 C93 86 80 92 68 100Z"/>
          <path d="M53 108 C43 102 26 104 12 101 C22 106 36 108 50 110Z"/>
          <path d="M67 108 C77 102 94 104 108 101 C98 106 84 108 70 110Z"/>
        </g>
      </svg>
    </div>

    <div style="text-align:center;position:relative;z-index:2;">
      <!-- Small divider line -->
      <div style="width:32px;height:1px;background:rgba(8,12,8,0.4);margin:0 auto 2rem;"></div>

      <h3 style="font-family:'Cormorant Garamond',Georgia,serif;font-size:clamp(3rem,5vw,4.5rem);font-style:italic;font-weight:400;color:#080C08;margin:0 0 1.5rem;line-height:0.95;letter-spacing:-0.01em;">
        Naturally.
      </h3>

      <div style="width:32px;height:1px;background:rgba(8,12,8,0.4);margin:0 auto 1.75rem;"></div>

      <p style="font-family:'Jost',sans-serif;font-size:0.82rem;color:rgba(8,12,8,0.65);line-height:1.75;max-width:280px;margin:0 auto;">
        No pesticides. No shortcuts.<br />Just the finest product nature<br />and craft can produce.
      </p>
    </div>
  </div>
</div>

<!-- Bottom wave divider -->
<div class="wave-divider" aria-hidden="true">
  <svg viewBox="0 0 1440 56" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M0,56 C400,0 1000,56 1440,16 L1440,56 L0,56Z" fill="#0D140D"/>
  </svg>
</div>
