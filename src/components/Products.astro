---
// Section 3 — Horizontal scroll showcase with 3D mouse-tilt cards
// Note: `prerender` must be declared on the page (src/pages/index.astro),
// not here — Astro only reads that export from route files.

import { createPublicClient } from '../lib/supabase-public.js';

const supabase = createPublicClient();
const { data: rows, error } = await supabase
  .from('products')
  .select('*')
  .eq('in_stock', true)
  .order('created_at', { ascending: false });

if (error) console.error('Failed to load products:', error.message);

function displayType(row: { category: string; strain_type: string | null }) {
  const cat = row.category.charAt(0).toUpperCase() + row.category.slice(1);
  if (row.category === 'flower' && row.strain_type) {
    return `${row.strain_type.charAt(0).toUpperCase() + row.strain_type.slice(1)} Flower`;
  }
  return cat;
}

function displayBadge(row: { category: string; strain_type: string | null }) {
  if (row.category === 'flower' && row.strain_type) return row.strain_type.toUpperCase();
  return row.category.toUpperCase();
}

const products = (rows || []).map((row) => ({
  id: row.id,
  name: row.name,
  type: displayType(row),
  badge: displayBadge(row),
  notes: row.weight_options && row.weight_options.length ? row.weight_options.join(' · ') : (row.description || ''),
  price: `R${Number(row.price).toFixed(0)}`,
  img: row.image_url || undefined,
}));
---

<section id="products" class="h-scroll-section">
  <div class="h-scroll-pin">

    <!-- Section header -->
    <div id="products-header" style="padding:2.5rem 5vw 1.5rem;display:flex;align-items:flex-end;justify-content:space-between;flex-shrink:0;flex-wrap:wrap;gap:1rem;">
      <div id="collection-heading" style="font-family:'Space Grotesk',sans-serif;font-size:clamp(2.25rem,9vw,120px);font-weight:700;color:#FFFFFF;letter-spacing:-0.04em;line-height:0.9;white-space:nowrap;overflow:visible;">
        THE COLLECTION
      </div>
      <div id="products-meta" style="text-align:right;flex-shrink:0;padding-left:2rem;">
        <p style="font-family:'Space Grotesk',sans-serif;font-size:0.72rem;color:#8B949E;letter-spacing:0.1em;text-transform:uppercase;margin-bottom:0.25rem;">{products.length} product{products.length === 1 ? '' : 's'}</p>
        <p id="products-scroll-hint" style="font-family:'Space Grotesk',sans-serif;font-size:0.72rem;color:#00C896;letter-spacing:0.1em;">DRAG OR SCROLL ↓</p>
      </div>
    </div>

    <!-- Progress bar -->
    <div class="h-progress" style="flex-shrink:0;margin:0 5vw;">
      <div class="h-progress-fill" id="h-progress-fill"></div>
    </div>

    <!-- Cards track -->
    <div id="h-scroll-track" class="h-scroll-track" style="flex:1;align-items:center;">
      {products.map((p, i) => (
        <article class="product-card-3d" data-index={i} aria-label={p.name}>

          <!-- Glow shimmer layer (follows mouse) -->
          <div class="card-shimmer" style="position:absolute;inset:0;pointer-events:none;border-radius:inherit;"></div>

          <!-- Product image or leaf placeholder -->
          <div style="width:100%;height:180px;overflow:hidden;margin-bottom:1.25rem;position:relative;background:#0A0F0A;">
            {p.img ? (
              <img
                src={p.img}
                alt={p.name}
                style="width:100%;height:100%;object-fit:cover;object-position:center;display:block;transition:transform 0.6s ease;"
                class="card-img"
              />
            ) : (
              <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;">
                <svg viewBox="0 0 120 160" width="70" height="93" fill="none" aria-hidden="true">
                  <g stroke="#00C896" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" opacity="0.18">
                    <path d="M60 155 C60 155 58 133 60 115"/>
                    <path d="M60 115 C55 95 48 75 46 52 C50 62 55 78 57 88 C54 72 53 48 60 30 C67 48 66 72 63 88 C65 78 70 62 74 52 C72 75 65 95 60 115Z"/>
                    <path d="M56 100 C48 92 32 86 18 80 C27 86 40 92 52 100Z"/>
                    <path d="M64 100 C72 92 88 86 102 80 C93 86 80 92 68 100Z"/>
                    <path d="M53 108 C43 102 26 104 12 101 C22 106 36 108 50 110Z"/>
                    <path d="M67 108 C77 102 94 104 108 101 C98 106 84 108 70 110Z"/>
                  </g>
                </svg>
              </div>
            )}
            <!-- Badge overlaid on image -->
            <span style="position:absolute;top:10px;left:10px;font-family:'Space Grotesk',sans-serif;font-size:0.58rem;font-weight:700;letter-spacing:0.14em;color:#06080A;background:#00C896;padding:3px 10px;text-transform:uppercase;">
              {p.badge}
            </span>
          </div>

          <!-- Text info -->
          <div style="padding:0 1.5rem;">
            <h3 style="font-family:'Space Grotesk',sans-serif;font-size:1.375rem;font-weight:700;color:#FFFFFF;letter-spacing:-0.03em;line-height:1.1;margin-bottom:0.4rem;">
              {p.name}
            </h3>
            <p style="font-family:'Space Grotesk',sans-serif;font-size:0.75rem;color:#8B949E;letter-spacing:0.04em;text-transform:uppercase;margin-bottom:0.5rem;">
              {p.type}
            </p>
            <p style="font-family:'Space Grotesk',sans-serif;font-size:0.72rem;color:rgba(139,148,158,0.6);font-style:italic;">
              {p.notes}
            </p>
          </div>

          <!-- Bottom section -->
          <div style="display:flex;align-items:flex-end;justify-content:space-between;margin-top:auto;padding-top:1.25rem;padding-left:1.5rem;padding-right:1.5rem;">
            <div>
              <div style="font-family:'Space Grotesk',sans-serif;font-size:0.65rem;color:#8B949E;letter-spacing:0.06em;text-transform:uppercase;margin-bottom:0.2rem;">FROM</div>
              <div style="font-family:'Space Grotesk',sans-serif;font-size:2rem;font-weight:700;color:#00C896;letter-spacing:-0.03em;line-height:1;">
                {p.price}
              </div>
            </div>
            <div class="card-cta" style="font-family:'Space Grotesk',sans-serif;font-size:0.82rem;font-weight:700;color:#FFFFFF;letter-spacing:0.06em;display:flex;align-items:center;gap:0.4rem;transition:color 0.25s,gap 0.25s;">
              ADD <span style="transition:transform 0.25s;">→</span>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  @media (max-width: 767px) {
    #products-meta { text-align: left !important; padding-left: 0 !important; }
  }
</style>

<script is:inline>
(function () {
  document.addEventListener('DOMContentLoaded', function () {

    var section  = document.querySelector('.h-scroll-section');
    var track    = document.getElementById('h-scroll-track');
    var fill     = document.getElementById('h-progress-fill');
    var mq       = window.matchMedia('(max-width: 767px)');
    var bound    = false;

    /* ── HORIZONTAL SCROLL (desktop / landscape tablet only) ── */
    function updateHScroll() {
      var sectionTop  = section.offsetTop;
      var sectionH    = section.offsetHeight;
      var winH        = window.innerHeight;
      var scrolled    = window.scrollY - sectionTop;
      var maxScroll   = sectionH - winH;
      var progress    = Math.max(0, Math.min(1, scrolled / maxScroll));
      var maxTranslate = track.scrollWidth - window.innerWidth;
      var translateX  = progress * maxTranslate;

      track.style.transform = 'translateX(-' + translateX + 'px)';
      if (fill) fill.style.width = (progress * 100) + '%';
    }

    /* ── PROGRESS BAR from the track's own native scroll (mobile touch-swipe) ── */
    function updateTouchProgress() {
      var maxScroll = track.scrollWidth - track.clientWidth;
      var progress  = maxScroll > 0 ? Math.max(0, Math.min(1, track.scrollLeft / maxScroll)) : 0;
      if (fill) fill.style.width = (progress * 100) + '%';
    }

    function syncScrollMode() {
      if (!section || !track) return;
      if (mq.matches) {
        /* Mobile: no scroll-jacking — track scrolls natively via touch swipe */
        if (bound) {
          window.removeEventListener('scroll', updateHScroll);
          bound = false;
        }
        track.style.transform = '';
        track.addEventListener('scroll', updateTouchProgress, { passive: true });
        updateTouchProgress();
      } else {
        track.removeEventListener('scroll', updateTouchProgress);
        track.scrollLeft = 0;
        if (!bound) {
          window.addEventListener('scroll', updateHScroll, { passive: true });
          bound = true;
          updateHScroll();
        }
      }
    }

    syncScrollMode();
    if (mq.addEventListener) {
      mq.addEventListener('change', syncScrollMode);
    } else if (mq.addListener) {
      mq.addListener(syncScrollMode); /* older Safari */
    }
    window.addEventListener('resize', function () {
      if (!mq.matches) updateHScroll();
    }, { passive: true });

    /* ── 3D MOUSE TILT (desktop only) ── */
    if (!mq.matches) {
      document.querySelectorAll('.product-card-3d').forEach(function (card) {
        var ticking = false;

        card.addEventListener('mousemove', function (e) {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(function () {
            var rect    = card.getBoundingClientRect();
            var cx      = rect.left + rect.width / 2;
            var cy      = rect.top  + rect.height / 2;
            var dx      = (e.clientX - cx) / (rect.width / 2);
            var dy      = (e.clientY - cy) / (rect.height / 2);
            var rotY    =  dx * 14;
            var rotX    = -dy * 10;

            card.style.transition = 'transform 0.1s ease, box-shadow 0.1s ease';
            card.style.transform  = 'perspective(1000px) rotateX(' + rotX + 'deg) rotateY(' + rotY + 'deg) scale(1.02)';
            card.style.boxShadow  = '0 20px 50px rgba(0,200,150,0.1), 0 0 0 1px rgba(0,200,150,0.3)';

            /* shimmer follows mouse */
            var pctX = ((e.clientX - rect.left) / rect.width * 100).toFixed(1);
            var pctY = ((e.clientY - rect.top)  / rect.height * 100).toFixed(1);
            card.style.setProperty('--mx', pctX + '%');
            card.style.setProperty('--my', pctY + '%');

            ticking = false;
          });
        });

        card.addEventListener('mouseleave', function () {
          card.style.transition = 'transform 0.5s ease, box-shadow 0.5s ease';
          card.style.transform  = 'perspective(1000px) rotateX(0deg) rotateY(0deg) scale(1)';
          card.style.boxShadow  = '';
        });

        /* Card CTA arrow on hover */
        var cta = card.querySelector('.card-cta');
        if (cta) {
          var arrow = cta.querySelector('span');
          card.addEventListener('mouseenter', function () {
            if (cta) cta.style.color = '#00C896';
            if (arrow) arrow.style.transform = 'translateX(4px)';
          });
          card.addEventListener('mouseleave', function () {
            if (cta) cta.style.color = '#FFFFFF';
            if (arrow) arrow.style.transform = 'translateX(0)';
          });
        }
      });
    }

  });
})();
</script>
