---
// Section 7 — Single testimonial with progress bar, auto-advance, manual dots
---

<section style="background:#06080A;padding:8rem 0;position:relative;overflow:hidden;">

  <!-- Green glow background blob -->
  <div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:600px;height:400px;background:radial-gradient(ellipse,rgba(0,200,150,0.06) 0%,transparent 70%);pointer-events:none;" aria-hidden="true"></div>

  <!-- Progress bar -->
  <div class="testimonial-progress-bar" style="position:absolute;top:0;left:0;right:0;">
    <div class="testimonial-progress-fill" id="t-progress"></div>
  </div>

  <div style="max-width:900px;margin:0 auto;padding:0 2rem;position:relative;z-index:2;">

    <!-- Section label -->
    <div style="text-align:center;margin-bottom:3.5rem;" data-animate>
      <p style="font-family:'Space Grotesk',sans-serif;font-size:0.68rem;font-weight:700;letter-spacing:0.18em;color:#00C896;text-transform:uppercase;">
        What People Say
      </p>
    </div>

    <!-- Testimonials -->
    <div id="testimonials-container" style="min-height:260px;position:relative;">

      <div class="testimonial-item active" data-index="0">
        <div style="font-family:'Space Grotesk',sans-serif;font-size:clamp(4rem,12vw,7rem);font-weight:700;color:#00C896;line-height:0.7;text-align:center;margin-bottom:1.5rem;" aria-hidden="true">"</div>
        <blockquote style="font-family:'Space Grotesk',sans-serif;font-size:clamp(1.125rem,3vw,1.625rem);font-weight:600;color:#FFFFFF;letter-spacing:-0.02em;line-height:1.5;text-align:center;margin:0 0 2.5rem;">
          I have tried dispensaries in Cape Town and Johannesburg. Verdant is genuinely on par with the best of them — and it is right here in PMB. The staff know their product inside out.
        </blockquote>
        <div style="text-align:center;">
          <div style="font-family:'Space Grotesk',sans-serif;font-size:0.72rem;font-weight:700;letter-spacing:0.14em;color:#00C896;text-transform:uppercase;margin-bottom:0.375rem;">— MICHAEL T. · PIETERMARITZBURG</div>
          <div style="color:#00C896;font-size:0.9rem;letter-spacing:0.1em;">★★★★★</div>
        </div>
      </div>

      <div class="testimonial-item" data-index="1">
        <div style="font-family:'Space Grotesk',sans-serif;font-size:clamp(4rem,12vw,7rem);font-weight:700;color:#00C896;line-height:0.7;text-align:center;margin-bottom:1.5rem;" aria-hidden="true">"</div>
        <blockquote style="font-family:'Space Grotesk',sans-serif;font-size:clamp(1.125rem,3vw,1.625rem);font-weight:600;color:#FFFFFF;letter-spacing:-0.02em;line-height:1.5;text-align:center;margin:0 0 2.5rem;">
          Finally a cannabis store that does not feel sketchy. Clean, calm, knowledgeable staff. The Ember Drops tincture changed my sleep completely. Nothing else comes close.
        </blockquote>
        <div style="text-align:center;">
          <div style="font-family:'Space Grotesk',sans-serif;font-size:0.72rem;font-weight:700;letter-spacing:0.14em;color:#00C896;text-transform:uppercase;margin-bottom:0.375rem;">— PRIYA N. · PIETERMARITZBURG</div>
          <div style="color:#00C896;font-size:0.9rem;letter-spacing:0.1em;">★★★★★</div>
        </div>
      </div>

      <div class="testimonial-item" data-index="2">
        <div style="font-family:'Space Grotesk',sans-serif;font-size:clamp(4rem,12vw,7rem);font-weight:700;color:#00C896;line-height:0.7;text-align:center;margin-bottom:1.5rem;" aria-hidden="true">"</div>
        <blockquote style="font-family:'Space Grotesk',sans-serif;font-size:clamp(1.125rem,3vw,1.625rem);font-weight:600;color:#FFFFFF;letter-spacing:-0.02em;line-height:1.5;text-align:center;margin:0 0 2.5rem;">
          The Durban Poison is the real deal. Locally grown, properly cured, beautifully presented. Verdant has set the standard for what a cannabis store should be in South Africa.
        </blockquote>
        <div style="text-align:center;">
          <div style="font-family:'Space Grotesk',sans-serif;font-size:0.72rem;font-weight:700;letter-spacing:0.14em;color:#00C896;text-transform:uppercase;margin-bottom:0.375rem;">— JAMES K. · HOWICK</div>
          <div style="color:#00C896;font-size:0.9rem;letter-spacing:0.1em;">★★★★★</div>
        </div>
      </div>

    </div>

    <!-- Navigation dots -->
    <div style="display:flex;justify-content:center;gap:0.75rem;margin-top:3rem;" role="group" aria-label="Testimonial navigation">
      <button class="t-dot active" data-to="0" type="button" aria-label="Testimonial 1" style="width:8px;height:8px;border-radius:50%;background:#00C896;border:none;cursor:pointer;padding:0;transition:all 0.3s ease;"></button>
      <button class="t-dot" data-to="1" type="button" aria-label="Testimonial 2" style="width:8px;height:8px;border-radius:50%;background:rgba(0,200,150,0.25);border:none;cursor:pointer;padding:0;transition:all 0.3s ease;"></button>
      <button class="t-dot" data-to="2" type="button" aria-label="Testimonial 3" style="width:8px;height:8px;border-radius:50%;background:rgba(0,200,150,0.25);border:none;cursor:pointer;padding:0;transition:all 0.3s ease;"></button>
    </div>
  </div>
</section>

<script is:inline>
(function () {
  document.addEventListener('DOMContentLoaded', function () {
    var items    = document.querySelectorAll('.testimonial-item');
    var dots     = document.querySelectorAll('.t-dot');
    var progress = document.getElementById('t-progress');
    var current  = 0;
    var total    = items.length;
    var duration = 5000;
    var anim, timer;

    function show(idx) {
      items.forEach(function (el) { el.classList.remove('active'); });
      dots.forEach(function (d)  {
        d.style.background = 'rgba(0,200,150,0.25)';
        d.style.width = '8px';
      });

      items[idx].classList.add('active');
      dots[idx].style.background = '#00C896';
      dots[idx].style.width = '24px';
      dots[idx].style.borderRadius = '4px';

      startProgress();
    }

    function startProgress() {
      if (progress) {
        progress.style.transition = 'none';
        progress.style.width = '0%';
        void progress.offsetWidth; /* reflow */
        progress.style.transition = 'width ' + duration + 'ms linear';
        progress.style.width = '100%';
      }
      clearInterval(timer);
      timer = setTimeout(function () {
        current = (current + 1) % total;
        show(current);
      }, duration);
    }

    dots.forEach(function (dot) {
      dot.addEventListener('click', function () {
        current = parseInt(this.dataset.to, 10);
        show(current);
      });
    });

    show(0);
  });
})();
</script>
