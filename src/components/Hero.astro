---
// Section 1 — Hero: Asymmetric layout, bold typography, botanical watermark
---

<section id="home" class="grain" style="background-color:#080C08;min-height:100vh;overflow:hidden;position:relative;">

  <!-- Full-bleed botanical watermark -->
  <div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:min(80vh,700px);height:min(80vh,700px);pointer-events:none;z-index:0;opacity:0.035;" aria-hidden="true">
    <svg class="botanical-rotate" viewBox="0 0 120 160" fill="none" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%">
      <g stroke="#C9A84C" stroke-width="0.6" stroke-linecap="round" stroke-linejoin="round">
        <path d="M60 155 C60 155 58 133 60 115"/>
        <path d="M60 115 C55 95 48 75 46 52 C50 62 55 78 57 88 C54 72 53 48 60 30 C67 48 66 72 63 88 C65 78 70 62 74 52 C72 75 65 95 60 115Z"/>
        <path d="M56 100 C48 92 32 86 18 80 C27 86 40 92 52 100Z"/>
        <path d="M64 100 C72 92 88 86 102 80 C93 86 80 92 68 100Z"/>
        <path d="M53 108 C43 102 26 104 12 101 C22 106 36 108 50 110Z"/>
        <path d="M67 108 C77 102 94 104 108 101 C98 106 84 108 70 110Z"/>
        <path d="M52 112 C42 110 28 115 16 115 C25 118 38 117 54 115Z"/>
        <path d="M68 112 C78 110 92 115 104 115 C95 118 82 117 66 115Z"/>
      </g>
    </svg>
  </div>

  <!-- Warm gold glow behind blob (right side) -->
  <div class="hero-glow hide-mobile" aria-hidden="true"></div>

  <!-- Main hero layout -->
  <div class="hero-layout">

    <!-- LEFT COLUMN — Text -->
    <div style="position:relative;z-index:2;">

      <!-- Location label -->
      <div class="hero-line" style="display:flex;align-items:center;gap:1rem;margin-bottom:1.75rem;">
        <div style="width:50px;height:1px;background:#C9A84C;"></div>
        <span class="gold-label">Pietermaritzburg, KZN</span>
      </div>

      <!-- Main heading — staggered -->
      <h1 style="margin:0 0 1.5rem;line-height:0.95;">
        <span class="hero-line" style="display:block;font-family:'Cormorant Garamond',Georgia,serif;font-size:clamp(52px,7.5vw,96px);font-style:italic;font-weight:400;color:#F5F0E8;letter-spacing:-0.01em;">
          The Art of
        </span>
        <span class="hero-line" style="display:block;font-family:'Cormorant Garamond',Georgia,serif;font-size:clamp(64px,9.5vw,118px);font-style:italic;font-weight:500;color:#C9A84C;letter-spacing:-0.02em;margin-top:-0.05em;">
          Cannabis.
        </span>
        <span class="hero-line" style="display:block;font-family:'Cormorant Garamond',Georgia,serif;font-size:clamp(52px,7.5vw,96px);font-style:italic;font-weight:400;color:#F5F0E8;letter-spacing:-0.01em;margin-top:-0.05em;">
          Elevated.
        </span>
      </h1>

      <!-- Body copy -->
      <p class="hero-line" style="font-family:'Jost',sans-serif;font-size:1.0625rem;color:#9DB8A0;line-height:1.75;max-width:480px;margin:0 0 2.25rem;">
        Verdant is Pietermaritzburg's first premium cannabis dispensary. We source only the finest cultivars, extracts and wellness products — curated for the discerning adult.
      </p>

      <!-- CTA Buttons -->
      <div class="hero-line" style="display:flex;flex-wrap:wrap;gap:1rem;">
        <a href="#products" class="btn-gold">Explore Products</a>
        <a href="#about"    class="btn-outline">Our Story</a>
      </div>
    </div>

    <!-- RIGHT COLUMN — Blob with mini product cards -->
    <div class="hero-right-col" style="position:relative;z-index:2;display:flex;justify-content:center;align-items:center;">
      <div style="position:relative;width:100%;max-width:420px;">

        <!-- Blob container -->
        <div class="hero-blob" style="padding:3rem 2.5rem;position:relative;">
          <!-- Inner noise -->
          <div style="position:absolute;inset:0;z-index:0;opacity:0.04;background-image:url(data:image/svg+xml,%3Csvg%20xmlns%3D'http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg'%20width%3D'200'%20height%3D'200'%3E%3Cfilter%20id%3D'n'%3E%3CfeTurbulence%20type%3D'fractalNoise'%20baseFrequency%3D'0.85'%20numOctaves%3D'4'%20stitchTiles%3D'stitch'%2F%3E%3C%2Ffilter%3E%3Crect%20width%3D'200'%20height%3D'200'%20filter%3D'url(%23n)'%2F%3E%3C%2Fsvg%3E);"></div>

          <!-- Botanical watermark inside blob -->
          <div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:200px;height:260px;opacity:0.06;pointer-events:none;" aria-hidden="true">
            <svg viewBox="0 0 120 160" fill="none" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%">
              <g stroke="#C9A84C" stroke-width="0.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M60 155 C60 155 58 133 60 115"/>
                <path d="M60 115 C55 95 48 75 46 52 C50 62 55 78 57 88 C54 72 53 48 60 30 C67 48 66 72 63 88 C65 78 70 62 74 52 C72 75 65 95 60 115Z"/>
                <path d="M56 100 C48 92 32 86 18 80 C27 86 40 92 52 100Z"/>
                <path d="M64 100 C72 92 88 86 102 80 C93 86 80 92 68 100Z"/>
                <path d="M53 108 C43 102 26 104 12 101 C22 106 36 108 50 110Z"/>
                <path d="M67 108 C77 102 94 104 108 101 C98 106 84 108 70 110Z"/>
              </g>
            </svg>
          </div>

          <!-- Mini product cards -->
          <div style="display:flex;flex-direction:column;gap:1.125rem;position:relative;z-index:2;">

            <div class="mini-product-card">
              <div style="display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:0.25rem;">
                <span style="font-family:'Cormorant Garamond',Georgia,serif;font-size:1.2rem;font-style:italic;color:#C9A84C;font-weight:500;">Durban Poison</span>
                <span style="font-family:'Jost',sans-serif;font-size:0.6rem;letter-spacing:0.12em;color:#080C08;background:#C9A84C;padding:2px 8px;border-radius:99px;text-transform:uppercase;font-weight:600;margin-top:3px;white-space:nowrap;">Flower</span>
              </div>
              <span style="font-family:'Jost',sans-serif;font-size:0.72rem;color:#74C69D;letter-spacing:0.06em;text-transform:uppercase;">Premium Sativa · R180/3.5g</span>
            </div>

            <div class="mini-product-card">
              <div style="display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:0.25rem;">
                <span style="font-family:'Cormorant Garamond',Georgia,serif;font-size:1.2rem;font-style:italic;color:#C9A84C;font-weight:500;">Golden Hour</span>
                <span style="font-family:'Jost',sans-serif;font-size:0.6rem;letter-spacing:0.12em;color:#080C08;background:#C9A84C;padding:2px 8px;border-radius:99px;text-transform:uppercase;font-weight:600;margin-top:3px;white-space:nowrap;">Vape</span>
              </div>
              <span style="font-family:'Jost',sans-serif;font-size:0.72rem;color:#74C69D;letter-spacing:0.06em;text-transform:uppercase;">Live Resin · R350/1g</span>
            </div>

            <div class="mini-product-card">
              <div style="display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:0.25rem;">
                <span style="font-family:'Cormorant Garamond',Georgia,serif;font-size:1.2rem;font-style:italic;color:#C9A84C;font-weight:500;">Ember Drops</span>
                <span style="font-family:'Jost',sans-serif;font-size:0.6rem;letter-spacing:0.12em;color:#080C08;background:#C9A84C;padding:2px 8px;border-radius:99px;text-transform:uppercase;font-weight:600;margin-top:3px;white-space:nowrap;">Tincture</span>
              </div>
              <span style="font-family:'Jost',sans-serif;font-size:0.72rem;color:#74C69D;letter-spacing:0.06em;text-transform:uppercase;">CBD:THC 4:1 · R380/30ml</span>
            </div>
          </div>
        </div>

        <!-- Rating badge floating -->
        <div style="position:absolute;bottom:-20px;right:-20px;background:#C9A84C;border-radius:50%;width:88px;height:88px;display:flex;flex-direction:column;align-items:center;justify-content:center;box-shadow:0 8px 32px rgba(201,168,76,0.4);">
          <span style="font-family:'Cormorant Garamond',Georgia,serif;font-size:1.5rem;font-style:italic;color:#080C08;font-weight:600;line-height:1;">PMB</span>
          <span style="font-family:'Jost',sans-serif;font-size:0.5rem;letter-spacing:0.12em;color:#080C08;font-weight:600;text-transform:uppercase;line-height:1.2;margin-top:2px;">#1 Store</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Marquee strip -->
  <div style="position:absolute;bottom:0;left:0;right:0;border-top:1px solid rgba(201,168,76,0.2);background:rgba(8,12,8,0.8);padding:0.875rem 0;overflow:hidden;z-index:3;" aria-hidden="true">
    <div class="marquee-wrapper">
      <div class="marquee-track">
        <!-- Duplicate content for seamless loop -->
        <span style="font-family:'Jost',sans-serif;font-size:0.68rem;letter-spacing:0.22em;color:#C9A84C;font-weight:500;text-transform:uppercase;padding:0 2rem;">PREMIUM FLOWER</span>
        <span style="color:rgba(201,168,76,0.5);">◆</span>
        <span style="font-family:'Jost',sans-serif;font-size:0.68rem;letter-spacing:0.22em;color:#C9A84C;font-weight:500;text-transform:uppercase;padding:0 2rem;">LIVE RESIN</span>
        <span style="color:rgba(201,168,76,0.5);">◆</span>
        <span style="font-family:'Jost',sans-serif;font-size:0.68rem;letter-spacing:0.22em;color:#C9A84C;font-weight:500;text-transform:uppercase;padding:0 2rem;">EDIBLES</span>
        <span style="color:rgba(201,168,76,0.5);">◆</span>
        <span style="font-family:'Jost',sans-serif;font-size:0.68rem;letter-spacing:0.22em;color:#C9A84C;font-weight:500;text-transform:uppercase;padding:0 2rem;">TINCTURES</span>
        <span style="color:rgba(201,168,76,0.5);">◆</span>
        <span style="font-family:'Jost',sans-serif;font-size:0.68rem;letter-spacing:0.22em;color:#C9A84C;font-weight:500;text-transform:uppercase;padding:0 2rem;">ACCESSORIES</span>
        <span style="color:rgba(201,168,76,0.5);">◆</span>
        <span style="font-family:'Jost',sans-serif;font-size:0.68rem;letter-spacing:0.22em;color:#C9A84C;font-weight:500;text-transform:uppercase;padding:0 2rem;">PMB'S FINEST</span>
        <span style="color:rgba(201,168,76,0.5);">◆</span>
        <span style="font-family:'Jost',sans-serif;font-size:0.68rem;letter-spacing:0.22em;color:#C9A84C;font-weight:500;text-transform:uppercase;padding:0 2rem;">LOCALLY CURATED</span>
        <span style="color:rgba(201,168,76,0.5);">◆</span>
        <span style="font-family:'Jost',sans-serif;font-size:0.68rem;letter-spacing:0.22em;color:#C9A84C;font-weight:500;text-transform:uppercase;padding:0 2rem;">18+ ONLY</span>
        <span style="color:rgba(201,168,76,0.5);">◆</span>
        <!-- Duplicate -->
        <span style="font-family:'Jost',sans-serif;font-size:0.68rem;letter-spacing:0.22em;color:#C9A84C;font-weight:500;text-transform:uppercase;padding:0 2rem;">PREMIUM FLOWER</span>
        <span style="color:rgba(201,168,76,0.5);">◆</span>
        <span style="font-family:'Jost',sans-serif;font-size:0.68rem;letter-spacing:0.22em;color:#C9A84C;font-weight:500;text-transform:uppercase;padding:0 2rem;">LIVE RESIN</span>
        <span style="color:rgba(201,168,76,0.5);">◆</span>
        <span style="font-family:'Jost',sans-serif;font-size:0.68rem;letter-spacing:0.22em;color:#C9A84C;font-weight:500;text-transform:uppercase;padding:0 2rem;">EDIBLES</span>
        <span style="color:rgba(201,168,76,0.5);">◆</span>
        <span style="font-family:'Jost',sans-serif;font-size:0.68rem;letter-spacing:0.22em;color:#C9A84C;font-weight:500;text-transform:uppercase;padding:0 2rem;">TINCTURES</span>
        <span style="color:rgba(201,168,76,0.5);">◆</span>
        <span style="font-family:'Jost',sans-serif;font-size:0.68rem;letter-spacing:0.22em;color:#C9A84C;font-weight:500;text-transform:uppercase;padding:0 2rem;">ACCESSORIES</span>
        <span style="color:rgba(201,168,76,0.5);">◆</span>
        <span style="font-family:'Jost',sans-serif;font-size:0.68rem;letter-spacing:0.22em;color:#C9A84C;font-weight:500;text-transform:uppercase;padding:0 2rem;">PMB'S FINEST</span>
        <span style="color:rgba(201,168,76,0.5);">◆</span>
        <span style="font-family:'Jost',sans-serif;font-size:0.68rem;letter-spacing:0.22em;color:#C9A84C;font-weight:500;text-transform:uppercase;padding:0 2rem;">LOCALLY CURATED</span>
        <span style="color:rgba(201,168,76,0.5);">◆</span>
        <span style="font-family:'Jost',sans-serif;font-size:0.68rem;letter-spacing:0.22em;color:#C9A84C;font-weight:500;text-transform:uppercase;padding:0 2rem;">18+ ONLY</span>
        <span style="color:rgba(201,168,76,0.5);">◆</span>
      </div>
    </div>
  </div>
</section>
