---
// Section 1 — Hero: Canvas particles, massive text, rotating circular text
---

<section id="home" style="position:relative;min-height:100vh;background:#06080A;overflow:hidden;display:flex;align-items:center;">

  <!-- Smoke particle canvas -->
  <canvas id="hero-canvas" style="position:absolute;inset:0;z-index:0;pointer-events:none;" aria-hidden="true"></canvas>

  <!-- Hero content — hard left aligned -->
  <div style="position:relative;z-index:2;padding:8rem 0 6rem 60px;max-width:100%;">

    <!-- Location label -->
    <div class="hero-line" style="display:flex;align-items:center;gap:1rem;margin-bottom:2rem;">
      <div style="width:32px;height:1px;background:#00C896;"></div>
      <span style="font-family:'Space Grotesk',sans-serif;font-size:0.72rem;font-weight:600;letter-spacing:0.18em;text-transform:uppercase;color:#00C896;">Pietermaritzburg, KZN</span>
    </div>

    <!-- Main stacked type -->
    <h1 style="margin:0;padding:0;line-height:0.88;">
      <span class="hero-line" style="font-family:'Space Grotesk',sans-serif;font-size:clamp(80px,13vw,160px);font-weight:700;color:#FFFFFF;letter-spacing:-0.04em;">
        THE
      </span>
      <span class="hero-line text-glow-green" style="font-family:'Space Grotesk',sans-serif;font-size:clamp(100px,16vw,200px);font-weight:700;color:#00C896;letter-spacing:-0.04em;display:block;overflow:visible;">
        FINEST.
      </span>
      <span class="hero-line text-outline-white" style="font-family:'Space Grotesk',sans-serif;font-size:clamp(80px,13vw,160px);font-weight:700;letter-spacing:-0.04em;display:block;">
        NATURALLY.
      </span>
    </h1>

    <!-- Subtext -->
    <p class="hero-line" style="font-family:'Space Grotesk',sans-serif;font-size:1rem;color:#8B949E;line-height:1.7;margin-top:2.5rem;max-width:420px;">
      Pietermaritzburg's first premium cannabis dispensary.<br />Curated. Lab tested. 18+.
    </p>

    <!-- Scroll indicator + explore link -->
    <div class="hero-line" style="display:flex;align-items:flex-end;gap:4rem;margin-top:3.5rem;">

      <!-- Scroll indicator -->
      <div style="display:flex;align-items:center;gap:1rem;" aria-label="Scroll down">
        <div style="width:1px;height:60px;background:rgba(0,200,150,0.3);position:relative;overflow:hidden;">
          <div class="scroll-dot" style="position:absolute;top:0;left:-1px;width:3px;height:12px;background:#00C896;border-radius:2px;"></div>
        </div>
        <span style="font-family:'Space Grotesk',sans-serif;font-size:0.6rem;font-weight:700;letter-spacing:0.18em;color:#00C896;text-transform:uppercase;writing-mode:vertical-rl;transform:rotate(180deg);">SCROLL</span>
      </div>

      <!-- Explore link -->
      <a href="#products" style="font-family:'Space Grotesk',sans-serif;font-size:1.25rem;font-weight:700;color:#FFFFFF;text-decoration:none;letter-spacing:-0.02em;position:relative;display:inline-block;" id="hero-explore">
        EXPLORE →
        <span style="position:absolute;bottom:-3px;left:0;right:0;height:2px;background:#00C896;transform:scaleX(0);transform-origin:left;transition:transform 0.3s ease;" id="hero-underline"></span>
      </a>
    </div>
  </div>

  <!-- RIGHT — rotating cannabis leaf + circular text -->
  <div id="rotating-widget" style="position:absolute;right:80px;top:50%;transform:translateY(-50%);display:flex;align-items:center;justify-content:center;z-index:2;" aria-hidden="true">
    <!-- Outer rotating circular text -->
    <svg id="circular-text-svg" viewBox="0 0 260 260" width="260" height="260" style="position:absolute;animation:marquee-left 20s linear infinite;">
      <defs>
        <path id="circ" d="M 130,130 m -108,0 a 108,108 0 1,1 216,0 a 108,108 0 1,1 -216,0"/>
      </defs>
      <text fill="#FFFFFF" font-family="Space Grotesk, sans-serif" font-size="11" font-weight="600" letter-spacing="4">
        <textPath href="#circ">VERDANT · PMB · EST 2024 · 18+ ONLY · VERDANT · PMB · EST 2024 · 18+ ONLY ·</textPath>
      </text>
    </svg>

    <!-- Inner rotating cannabis leaf -->
    <svg id="center-leaf" viewBox="0 0 120 160" width="80" height="107" fill="none" style="animation:marquee-left 20s linear infinite reverse;">
      <g stroke="#00C896" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M60 155 C60 155 58 133 60 115"/>
        <path d="M60 115 C55 95 48 75 46 52 C50 62 55 78 57 88 C54 72 53 48 60 30 C67 48 66 72 63 88 C65 78 70 62 74 52 C72 75 65 95 60 115Z"/>
        <path d="M56 100 C48 92 32 86 18 80 C27 86 40 92 52 100Z"/>
        <path d="M64 100 C72 92 88 86 102 80 C93 86 80 92 68 100Z"/>
        <path d="M53 108 C43 102 26 104 12 101 C22 106 36 108 50 110Z"/>
        <path d="M67 108 C77 102 94 104 108 101 C98 106 84 108 70 110Z"/>
        <path d="M52 112 C42 110 28 115 16 115 C25 118 38 117 54 115Z"/>
        <path d="M68 112 C78 110 92 115 104 115 C95 118 82 117 66 115Z"/>
      </g>
    </svg>
  </div>

  <!-- Bottom gradient fade -->
  <div style="position:absolute;bottom:0;left:0;right:0;height:120px;background:linear-gradient(to top, #06080A, transparent);z-index:1;" aria-hidden="true"></div>
</section>

<script is:inline>
(function () {
  document.addEventListener('DOMContentLoaded', function () {

    /* ── EXPLORE LINK UNDERLINE ── */
    var exploreLink = document.getElementById('hero-explore');
    var underline   = document.getElementById('hero-underline');
    if (exploreLink && underline) {
      exploreLink.addEventListener('mouseenter', function () { underline.style.transform = 'scaleX(1)'; });
      exploreLink.addEventListener('mouseleave', function () { underline.style.transform = 'scaleX(0)'; });
    }

    /* ── HIDE ROTATING WIDGET ON MOBILE ── */
    var widget = document.getElementById('rotating-widget');
    if (widget && window.innerWidth < 768) { widget.style.display = 'none'; }

    /* ── SMOKE PARTICLE CANVAS ── */
    initParticleCanvas('hero-canvas');

  });

  /* Shared particle init — called from Hero and CTA */
  function initParticleCanvas(canvasId) {
    var canvas = document.getElementById(canvasId);
    if (!canvas) return;
    var ctx = canvas.getContext('2d');
    if (!ctx) return;

    var particles = [];
    var raf;
    var paused = false;

    function resize() {
      canvas.width  = canvas.offsetWidth;
      canvas.height = canvas.offsetHeight;
    }
    resize();
    window.addEventListener('resize', resize, { passive: true });

    /* Page visibility: pause when hidden */
    document.addEventListener('visibilitychange', function () {
      paused = document.hidden;
      if (!paused) loop();
    });

    function spawn() {
      return {
        x:   Math.random() * canvas.width,
        y:   canvas.height + 10,
        vx:  (Math.random() - 0.5) * 0.5,
        vy:  -(0.3 + Math.random() * 0.5),
        r:   1 + Math.random() * 2,
        a:   0.08 + Math.random() * 0.28,
        max: 0.08 + Math.random() * 0.28,
      };
    }

    for (var i = 0; i < 80; i++) {
      var p = spawn();
      p.y = Math.random() * canvas.height; /* spread initial positions */
      particles.push(p);
    }

    function loop() {
      if (paused) return;
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      for (var j = 0; j < particles.length; j++) {
        var pt = particles[j];
        pt.x += pt.vx + Math.sin(Date.now() * 0.0008 + j) * 0.18;
        pt.y += pt.vy;
        pt.a  = pt.max * (pt.y / canvas.height);

        ctx.beginPath();
        ctx.arc(pt.x, pt.y, pt.r, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(0,200,150,' + Math.max(0, pt.a) + ')';
        ctx.fill();

        if (pt.y < -10) { particles[j] = spawn(); }
      }

      raf = requestAnimationFrame(loop);
    }
    loop();
  }

  /* Expose for CTA section */
  window.initParticleCanvas = initParticleCanvas;
})();
</script>
