---
// Section 6 — Education tabs with slide transitions and background number

interface Tab {
  id: string;
  label: string;
  num: string;
  heading: string;
  body: string;
}

const tabs: Tab[] = [
  {
    id:      'sativa',
    label:   'SATIVA vs INDICA',
    num:     '01',
    heading: 'Know your genetics.',
    body:    'Sativa strains tend to produce uplifting, energising effects — suited to daytime use, creative work, and social situations. Indica strains tend to relax and sedate — ideal for evenings, recovery, and sleep. Hybrid strains combine traits of both. The truth is more complex than this — terpene profiles matter as much as genetics. Our team will walk you through the nuances.',
  },
  {
    id:      'cbd',
    label:   'CBD vs THC',
    num:     '02',
    heading: 'Two molecules. Very different effects.',
    body:    'THC (tetrahydrocannabinol) is the psychoactive compound responsible for the classic cannabis high. CBD (cannabidiol) is non-psychoactive and is used primarily for wellness — managing anxiety, pain, and sleep. Many products contain both compounds in specific ratios. A 4:1 CBD:THC ratio, for example, offers therapeutic benefit with minimal psychoactive effect.',
  },
  {
    id:      'choosing',
    label:   'CHOOSING YOUR PRODUCT',
    num:     '03',
    heading: 'Start low. Go slow.',
    body:    "If you're new to cannabis, resist the urge to go straight for the highest THC product. Start with a low-dose edible or a 4:1 CBD:THC tincture. Edibles metabolise differently — effects can take 45 minutes to 2 hours to onset and last much longer. Flower and vapes offer faster, more manageable onset. Use our Strain Finder to get a personalised recommendation.",
  },
  {
    id:      'consume',
    label:   'HOW TO CONSUME',
    num:     '04',
    heading: 'Method changes everything.',
    body:    'Flower is smoked or vaporised for near-instant effect. Vape cartridges offer a cleaner, more discreet experience with consistent dosing. Edibles — chocolates, gummies — are metabolised through the liver, producing stronger, longer effects. Tinctures are placed under the tongue (sublingual) for rapid absorption and precise dosing. We recommend starting with tinctures if you want maximum control.',
  },
];
---

<section id="education" style="background:#0D1117;padding:8rem 0;">
  <div style="max-width:1200px;margin:0 auto;padding:0 2rem;">

    <!-- Section label -->
    <div data-animate style="margin-bottom:3.5rem;">
      <p style="font-family:'Space Grotesk',sans-serif;font-size:0.68rem;font-weight:700;letter-spacing:0.18em;color:#00C896;text-transform:uppercase;margin-bottom:1rem;">Know Your Plant</p>
      <h2 style="font-family:'Space Grotesk',sans-serif;font-size:clamp(2.5rem,6vw,4.5rem);font-weight:700;color:#FFFFFF;letter-spacing:-0.04em;line-height:1;">
        Cannabis 101
      </h2>
    </div>

    <!-- Tab layout -->
    <div style="display:grid;grid-template-columns:28% 72%;gap:0;border:1px solid rgba(0,200,150,0.12);" id="edu-layout">

      <!-- Tab list -->
      <div style="border-right:1px solid rgba(0,200,150,0.12);" role="tablist" aria-label="Cannabis education topics">
        {tabs.map((t, i) => (
          <button
            class={`edu-tab${i === 0 ? ' active' : ''}`}
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-controls={`panel-${t.id}`}
            id={`tab-${t.id}`}
            data-tab={t.id}
            type="button"
          >
            <span style="display:block;font-size:0.6rem;font-weight:700;letter-spacing:0.14em;color:rgba(139,148,158,0.5);margin-bottom:0.25rem;">{t.num}</span>
            {t.label}
          </button>
        ))}
      </div>

      <!-- Tab panels -->
      <div style="position:relative;overflow:hidden;">
        {tabs.map((t, i) => (
          <div
            class={`tab-panel${i === 0 ? ' active' : ''}`}
            role="tabpanel"
            id={`panel-${t.id}`}
            aria-labelledby={`tab-${t.id}`}
          >
            <!-- Background number watermark -->
            <div style="position:absolute;top:-1rem;left:2rem;font-family:'Space Grotesk',sans-serif;font-size:min(18vw,200px);font-weight:700;color:#00C896;opacity:0.04;line-height:1;pointer-events:none;z-index:0;letter-spacing:-0.04em;" aria-hidden="true">
              {t.num}
            </div>

            <!-- Content -->
            <div style="position:relative;z-index:2;padding:3.5rem;">
              <h3 style="font-family:'Space Grotesk',sans-serif;font-size:clamp(1.75rem,4vw,3rem);font-weight:700;color:#FFFFFF;letter-spacing:-0.04em;line-height:1.1;margin-bottom:2rem;">
                {t.heading}
              </h3>
              <p style="font-family:'Space Grotesk',sans-serif;font-size:0.9375rem;color:#8B949E;line-height:1.85;max-width:560px;">
                {t.body}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script is:inline>
(function () {
  document.addEventListener('DOMContentLoaded', function () {
    var tabs   = document.querySelectorAll('.edu-tab');
    var panels = document.querySelectorAll('.tab-panel');

    tabs.forEach(function (tab) {
      tab.addEventListener('click', function () {
        var id = this.dataset.tab;

        tabs.forEach(function (t) { t.classList.remove('active'); t.setAttribute('aria-selected', 'false'); });
        panels.forEach(function (p) { p.classList.remove('active'); });

        this.classList.add('active');
        this.setAttribute('aria-selected', 'true');
        var panel = document.getElementById('panel-' + id);
        if (panel) panel.classList.add('active');
      });
    });
  });
})();
</script>

<style>
  @media (max-width: 768px) {
    #edu-layout { grid-template-columns: 1fr !important; }
    #edu-layout > div:first-child { border-right: none !important; border-bottom: 1px solid rgba(0,200,150,0.12); }
    .edu-tab { padding: 1rem 1.25rem; font-size: 0.8rem; }
    .tab-panel > div:last-child { padding: 2.25rem 1.5rem !important; }
  }
</style>
