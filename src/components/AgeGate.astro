---
// Age verification overlay — shown once per session
---

<div id="age-gate" class="grain" role="dialog" aria-modal="true" aria-label="Age verification">

  <!-- Subtle background pattern -->
  <div style="position:absolute;inset:0;background:radial-gradient(ellipse at 50% 40%, rgba(27,67,50,0.15) 0%, transparent 65%);pointer-events:none;"></div>

  <!-- Main content -->
  <div id="age-content" style="text-align:center;max-width:480px;width:100%;padding:2rem;position:relative;z-index:3;">

    <!-- Logo mark -->
    <div style="margin-bottom:1.5rem;display:flex;align-items:center;justify-content:center;gap:0.75rem;">
      <!-- Botanical leaf SVG -->
      <svg width="28" height="36" viewBox="0 0 120 160" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <g stroke="#C9A84C" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M60 155 C60 155 58 133 60 115"/>
          <path d="M60 115 C55 95 48 75 46 52 C50 62 55 78 57 88 C54 72 53 48 60 30 C67 48 66 72 63 88 C65 78 70 62 74 52 C72 75 65 95 60 115Z"/>
          <path d="M56 100 C48 92 32 86 18 80 C27 86 40 92 52 100Z"/>
          <path d="M64 100 C72 92 88 86 102 80 C93 86 80 92 68 100Z"/>
          <path d="M53 108 C43 102 26 104 12 101 C22 106 36 108 50 110Z"/>
          <path d="M67 108 C77 102 94 104 108 101 C98 106 84 108 70 110Z"/>
          <path d="M52 112 C42 110 28 115 16 115 C25 118 38 117 54 115Z"/>
          <path d="M68 112 C78 110 92 115 104 115 C95 118 82 117 66 115Z"/>
        </g>
      </svg>
      <span style="font-family:'Cormorant Garamond',Georgia,serif;font-size:2.25rem;font-style:italic;font-weight:500;color:#C9A84C;letter-spacing:0.08em;">VERDANT</span>
    </div>

    <!-- Decorative divider -->
    <div style="display:flex;align-items:center;gap:1rem;margin:0 auto 2rem;max-width:280px;">
      <div style="flex:1;height:1px;background:linear-gradient(to right, transparent, rgba(201,168,76,0.5));"></div>
      <span style="color:#C9A84C;font-size:0.5rem;">◆</span>
      <div style="flex:1;height:1px;background:linear-gradient(to left, transparent, rgba(201,168,76,0.5));"></div>
    </div>

    <!-- Large botanical watermark behind everything -->
    <div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:360px;height:480px;pointer-events:none;z-index:-1;opacity:0.04;">
      <svg viewBox="0 0 120 160" fill="none" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%">
        <g stroke="#C9A84C" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
          <path d="M60 155 C60 155 58 133 60 115"/>
          <path d="M60 115 C55 95 48 75 46 52 C50 62 55 78 57 88 C54 72 53 48 60 30 C67 48 66 72 63 88 C65 78 70 62 74 52 C72 75 65 95 60 115Z"/>
          <path d="M56 100 C48 92 32 86 18 80 C27 86 40 92 52 100Z"/>
          <path d="M64 100 C72 92 88 86 102 80 C93 86 80 92 68 100Z"/>
          <path d="M53 108 C43 102 26 104 12 101 C22 106 36 108 50 110Z"/>
          <path d="M67 108 C77 102 94 104 108 101 C98 106 84 108 70 110Z"/>
          <path d="M52 112 C42 110 28 115 16 115 C25 118 38 117 54 115Z"/>
          <path d="M68 112 C78 110 92 115 104 115 C95 118 82 117 66 115Z"/>
        </g>
      </svg>
    </div>

    <!-- Heading -->
    <h1 style="font-family:'Cormorant Garamond',Georgia,serif;font-size:clamp(1.6rem,4vw,2.2rem);font-style:italic;font-weight:400;color:#F5F0E8;line-height:1.2;margin:0 0 1rem;">
      You must be 18 or older to enter.
    </h1>

    <!-- Subtext -->
    <p style="font-family:'Jost',sans-serif;font-size:0.78rem;color:#74C69D;letter-spacing:0.06em;line-height:1.7;margin:0 auto 2.5rem;max-width:360px;">
      By entering this site you confirm you are 18 years of age or older and agree to our terms of use. This site contains information about cannabis products. Adults only.
    </p>

    <!-- Buttons -->
    <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;">
      <button id="age-confirm" class="btn-gold" style="min-width:190px;">
        I Am 18 or Older
      </button>
      <button id="age-deny" class="btn-outline" style="min-width:190px;">
        I Am Under 18
      </button>
    </div>

    <!-- Fine print -->
    <p style="font-family:'Jost',sans-serif;font-size:0.65rem;color:rgba(157,184,160,0.6);margin-top:2rem;letter-spacing:0.06em;">
      18+ ONLY · PIETERMARITZBURG · CONSUME RESPONSIBLY
    </p>
  </div>

  <!-- Rejected state -->
  <div id="age-rejected" style="text-align:center;max-width:400px;position:relative;z-index:3;">
    <svg width="40" height="52" viewBox="0 0 120 160" fill="none" xmlns="http://www.w3.org/2000/svg" style="margin:0 auto 1.5rem;display:block;" aria-hidden="true">
      <g stroke="#C9A84C" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M60 155 C60 155 58 133 60 115"/>
        <path d="M60 115 C55 95 48 75 46 52 C50 62 55 78 57 88 C54 72 53 48 60 30 C67 48 66 72 63 88 C65 78 70 62 74 52 C72 75 65 95 60 115Z"/>
        <path d="M56 100 C48 92 32 86 18 80 C27 86 40 92 52 100Z"/>
        <path d="M64 100 C72 92 88 86 102 80 C93 86 80 92 68 100Z"/>
        <path d="M53 108 C43 102 26 104 12 101 C22 106 36 108 50 110Z"/>
        <path d="M67 108 C77 102 94 104 108 101 C98 106 84 108 70 110Z"/>
      </g>
    </svg>
    <h2 style="font-family:'Cormorant Garamond',Georgia,serif;font-size:1.8rem;font-style:italic;color:#F5F0E8;margin:0 0 0.75rem;">Sorry.</h2>
    <p style="font-family:'Jost',sans-serif;color:#74C69D;font-size:0.85rem;line-height:1.7;">This site is for adults only.<br />Please come back when you are 18 or older.</p>
  </div>
</div>
