---
// Age Gate — SVG self-drawing leaf + text glitch + shard shatter reveal
---

<div id="age-gate" role="dialog" aria-modal="true" aria-label="Age verification">

  <!-- Verdant logotype -->
  <div style="text-align:center;margin-bottom:2.5rem;">
    <div style="font-family:'Space Grotesk',sans-serif;font-size:clamp(3rem,8vw,5rem);font-weight:700;letter-spacing:-0.04em;color:#FFFFFF;line-height:1;">
      VERDANT
    </div>
  </div>

  <!-- Self-drawing cannabis leaf SVG -->
  <div id="gate-leaf" style="margin-bottom:2.5rem;display:flex;justify-content:center;" aria-hidden="true">
    <svg viewBox="0 0 200 260" width="140" height="182" fill="none" xmlns="http://www.w3.org/2000/svg">
      <!-- Stem -->
      <path class="draw-path" d="M100 255 C100 255 97 225 100 200" stroke="#00C896" stroke-width="1.5" stroke-linecap="round"
        style="stroke-dasharray:60;stroke-dashoffset:60;animation:draw-path 0.4s ease 0.1s forwards;"/>

      <!-- Main center leaflet -->
      <path class="draw-path" d="M100 200 C95 175 82 145 78 110 C83 125 90 148 94 162 C89 140 87 108 100 75 C113 108 111 140 106 162 C110 148 117 125 122 110 C118 145 105 175 100 200Z"
        stroke="#00C896" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"
        style="stroke-dasharray:400;stroke-dashoffset:400;animation:draw-path 1.2s ease 0.5s forwards;"/>

      <!-- Upper left leaf -->
      <path class="draw-path" d="M94 178 C82 165 60 155 40 145 C54 154 70 163 87 178Z"
        stroke="#00C896" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"
        style="stroke-dasharray:120;stroke-dashoffset:120;animation:draw-path 0.6s ease 1.6s forwards;"/>

      <!-- Upper right leaf -->
      <path class="draw-path" d="M106 178 C118 165 140 155 160 145 C146 154 130 163 113 178Z"
        stroke="#00C896" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"
        style="stroke-dasharray:120;stroke-dashoffset:120;animation:draw-path 0.6s ease 1.9s forwards;"/>

      <!-- Left mid leaf -->
      <path class="draw-path" d="M89 188 C74 180 50 183 28 180 C44 186 62 188 84 192Z"
        stroke="#00C896" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"
        style="stroke-dasharray:130;stroke-dashoffset:130;animation:draw-path 0.6s ease 2.2s forwards;"/>

      <!-- Right mid leaf -->
      <path class="draw-path" d="M111 188 C126 180 150 183 172 180 C156 186 138 188 116 192Z"
        stroke="#00C896" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"
        style="stroke-dasharray:130;stroke-dashoffset:130;animation:draw-path 0.6s ease 2.2s forwards;"/>

      <!-- Lower left leaf -->
      <path class="draw-path" d="M86 195 C72 192 52 198 35 198 C48 202 64 200 82 200Z"
        stroke="#00C896" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round"
        style="stroke-dasharray:110;stroke-dashoffset:110;animation:draw-path 0.5s ease 2.7s forwards;"/>

      <!-- Lower right leaf -->
      <path class="draw-path" d="M114 195 C128 192 148 198 165 198 C152 202 136 200 118 200Z"
        stroke="#00C896" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round"
        style="stroke-dasharray:110;stroke-dashoffset:110;animation:draw-path 0.5s ease 2.7s forwards;"/>
    </svg>
  </div>

  <!-- Age question -->
  <div style="text-align:center;margin-bottom:2.5rem;">
    <p style="font-family:'Space Grotesk',sans-serif;font-size:1.15rem;font-weight:600;color:#FFFFFF;letter-spacing:0.04em;margin-bottom:0.5rem;">
      ARE YOU 18 OR OLDER?
    </p>
    <p style="font-family:'Space Grotesk',sans-serif;font-size:0.78rem;color:#8B949E;letter-spacing:0.06em;">
      You must be 18+ to enter this site
    </p>
  </div>

  <!-- Choices -->
  <div id="age-options" style="display:flex;flex-direction:column;align-items:center;gap:1.25rem;">
    <button
      id="age-confirm"
      class="age-link glitch-wrap"
      data-text="YES, LET ME IN"
      type="button"
      style="font-size:1.5rem;"
    >YES, LET ME IN</button>

    <button
      id="age-deny"
      type="button"
      style="font-family:'Space Grotesk',sans-serif;font-size:0.9rem;font-weight:500;color:#8B949E;background:none;border:none;cursor:pointer;letter-spacing:0.04em;"
    >NO, TAKE ME BACK</button>
  </div>

  <!-- Rejected state -->
  <div id="age-rejected" style="display:none;text-align:center;padding:2rem;">
    <p style="font-family:'Space Grotesk',sans-serif;font-size:1.25rem;font-weight:700;color:#8B949E;letter-spacing:-0.02em;margin-bottom:0.5rem;">
      This site is for adults only.
    </p>
    <p style="font-family:'Space Grotesk',sans-serif;font-size:0.8rem;color:#8B949E;">
      Please come back when you are 18 or older.
    </p>
  </div>
</div>

<script is:inline>
(function () {
  document.addEventListener('DOMContentLoaded', function () {
    var gate       = document.getElementById('age-gate');
    var options    = document.getElementById('age-options');
    var rejected   = document.getElementById('age-rejected');
    var confirmBtn = document.getElementById('age-confirm');
    var denyBtn    = document.getElementById('age-deny');

    if (!gate) return;

    /* Already verified — skip gate */
    if (localStorage.getItem('vrd-age') === '1') {
      gate.classList.add('gone');
      triggerHero();
      return;
    }

    /* DENY */
    if (denyBtn) {
      denyBtn.addEventListener('click', function () {
        if (options) options.style.display = 'none';
        if (rejected) rejected.style.display = 'block';
      });
    }

    /* CONFIRM — glitch → shatter */
    if (confirmBtn) {
      confirmBtn.addEventListener('click', function () {
        /* 1. Glitch the text */
        confirmBtn.classList.add('glitching');

        setTimeout(function () {
          /* 2. Build shards */
          shatter(gate);

          /* 3. After shards fly out, hide gate */
          setTimeout(function () {
            gate.classList.add('gone');
            localStorage.setItem('vrd-age', '1');
            triggerHero();
          }, 750);
        }, 350);
      });
    }

    function triggerHero() {
      document.querySelectorAll('.hero-line').forEach(function (el) {
        el.classList.add('animated');
      });
    }

    function shatter(container) {
      var rows = 4, cols = 5;
      var W = window.innerWidth;
      var H = window.innerHeight;
      var sw = W / cols;
      var sh = H / rows;

      for (var r = 0; r < rows; r++) {
        for (var c = 0; c < cols; c++) {
          var shard = document.createElement('div');
          shard.className = 'gate-shard';
          var delay = Math.random() * 0.2;
          var dur   = 0.35 + Math.random() * 0.35;
          var tx    = (c - cols / 2) * 220 + (Math.random() - 0.5) * 160;
          var ty    = (r - rows / 2) * 180 + (Math.random() - 0.5) * 120;
          var rot   = (Math.random() - 0.5) * 140;

          shard.style.cssText = [
            'left:'   + (c * sw)  + 'px',
            'top:'    + (r * sh)  + 'px',
            'width:'  + (sw + 1)  + 'px',
            'height:' + (sh + 1)  + 'px',
            'transition:transform ' + dur + 's cubic-bezier(.4,.2,.2,1) ' + delay + 's, opacity ' + dur + 's ease ' + delay + 's',
          ].join(';');

          container.appendChild(shard);

          /* Force reflow then fly */
          void shard.offsetWidth;
          shard.style.transform = 'translate(' + tx + 'px,' + ty + 'px) rotate(' + rot + 'deg)';
          shard.style.opacity   = '0';
        }
      }
    }

  });
})();
</script>
