---
// Section 2 — Strain Finder: 3-step quiz with product recommendation logic

interface Product {
  name: string;
  type: string;
  desc: string;
  price: string;
}

const products: Record<string, Product> = {
  'EMBER DROPS':     { name: 'EMBER DROPS',            type: 'Full Spectrum CBD:THC 4:1', desc: 'Perfect for first-timers seeking calm without intensity. Sub-lingual tincture, precise dosing, gentle onset.', price: 'R380 / 30ml' },
  'WEDDING CAKE':    { name: 'WEDDING CAKE',            type: 'Indica Flower',             desc: 'A deeply relaxing cultivar with vanilla and earth notes. Body-forward, ideal for evenings and recovery.', price: 'R220 / 3.5g' },
  'DURBAN POISON':   { name: 'DURBAN POISON',           type: 'Sativa Flower',             desc: 'South Africa\'s legendary landrace sativa. Uplifting, clear-headed, creative energy. The classic choice.', price: 'R180 / 3.5g' },
  'GOLDEN HOUR':     { name: 'GOLDEN HOUR',             type: 'Hybrid Live Resin Vape',    desc: 'Premium live resin hybrid for creative minds. Tropical fruit notes, balanced mind and body experience.', price: 'R350 / 1g' },
  'DARK FOREST':     { name: 'DARK FOREST CHOCOLATE',  type: '72% Dark · 100mg THC',      desc: 'Artisan 72% dark chocolate, 100mg THC. Slow burn, long lasting. The connoisseur\'s edible.', price: 'R120 / bar' },
};
---

<section id="strains" style="background:#0D1117;padding:8rem 0;">
  <div style="max-width:900px;margin:0 auto;padding:0 2rem;">

    <!-- Heading -->
    <div data-animate style="margin-bottom:3.5rem;">
      <div style="font-family:'Space Grotesk',sans-serif;font-size:clamp(2.5rem,7vw,5rem);font-weight:700;color:#FFFFFF;letter-spacing:-0.04em;line-height:0.9;">
        FIND YOUR
      </div>
      <div style="font-family:'Space Grotesk',sans-serif;font-size:clamp(2.5rem,7vw,5rem);font-weight:700;color:#00C896;letter-spacing:-0.04em;line-height:0.9;margin-bottom:1.5rem;">
        STRAIN.
      </div>
      <p style="font-family:'Space Grotesk',sans-serif;font-size:0.9rem;color:#8B949E;letter-spacing:0.02em;">
        Answer 3 questions. We recommend your perfect product.
      </p>
    </div>

    <!-- Step 1 -->
    <div class="quiz-step visible" id="step-1" data-animate data-delay="1">
      <p style="font-family:'Space Grotesk',sans-serif;font-size:0.72rem;font-weight:700;letter-spacing:0.16em;color:#00C896;text-transform:uppercase;margin-bottom:1rem;">01 / HOW DO YOU WANT TO FEEL?</p>
      <div style="display:flex;gap:0.75rem;flex-wrap:wrap;" id="step1-tiles">
        {['RELAXED','CREATIVE','ENERGISED','SLEEPY'].map(o => (
          <button class="quiz-tile" data-step="1" data-val={o} type="button">{o}</button>
        ))}
      </div>
    </div>

    <!-- Step 2 -->
    <div class="quiz-step" id="step-2" style="margin-top:2rem;">
      <p style="font-family:'Space Grotesk',sans-serif;font-size:0.72rem;font-weight:700;letter-spacing:0.16em;color:#00C896;text-transform:uppercase;margin-bottom:1rem;">02 / WHAT KIND OF EXPERIENCE?</p>
      <div style="display:flex;gap:0.75rem;flex-wrap:wrap;" id="step2-tiles">
        {['MIND','BODY','BOTH'].map(o => (
          <button class="quiz-tile" data-step="2" data-val={o} type="button">{o}</button>
        ))}
      </div>
    </div>

    <!-- Step 3 -->
    <div class="quiz-step" id="step-3" style="margin-top:2rem;">
      <p style="font-family:'Space Grotesk',sans-serif;font-size:0.72rem;font-weight:700;letter-spacing:0.16em;color:#00C896;text-transform:uppercase;margin-bottom:1rem;">03 / YOUR EXPERIENCE LEVEL?</p>
      <div style="display:flex;gap:0.75rem;flex-wrap:wrap;" id="step3-tiles">
        {['FIRST TIME','OCCASIONAL','SEASONED'].map(o => (
          <button class="quiz-tile" data-step="3" data-val={o} type="button">{o}</button>
        ))}
      </div>
    </div>

    <!-- Result -->
    <div class="result-card-wrap" id="quiz-result" style="margin-top:2.5rem;">
      <div style="border:1.5px solid #00C896;background:rgba(0,200,150,0.04);padding:2.5rem;position:relative;box-shadow:0 0 40px rgba(0,200,150,0.12);">
        <!-- Green glow corner -->
        <div style="position:absolute;top:-1px;left:-1px;width:48px;height:48px;border-top:2px solid #00C896;border-left:2px solid #00C896;"></div>
        <div style="position:absolute;bottom:-1px;right:-1px;width:48px;height:48px;border-bottom:2px solid #00C896;border-right:2px solid #00C896;"></div>

        <p style="font-family:'Space Grotesk',sans-serif;font-size:0.72rem;font-weight:700;letter-spacing:0.16em;color:#00C896;text-transform:uppercase;margin-bottom:1rem;">OUR RECOMMENDATION</p>
        <div id="result-name" style="font-family:'Space Grotesk',sans-serif;font-size:clamp(2rem,5vw,3rem);font-weight:700;color:#FFFFFF;letter-spacing:-0.03em;line-height:1;margin-bottom:0.5rem;"></div>
        <div id="result-type" style="font-family:'Space Grotesk',sans-serif;font-size:0.82rem;font-weight:600;color:#00C896;letter-spacing:0.08em;text-transform:uppercase;margin-bottom:1.25rem;"></div>
        <p id="result-desc" style="font-family:'Space Grotesk',sans-serif;font-size:0.9rem;color:#8B949E;line-height:1.7;margin-bottom:1.5rem;max-width:500px;"></p>
        <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem;">
          <div id="result-price" style="font-family:'Space Grotesk',sans-serif;font-size:1.5rem;font-weight:700;color:#00C896;letter-spacing:-0.02em;"></div>
          <a href="#products" style="font-family:'Space Grotesk',sans-serif;font-size:0.82rem;font-weight:700;color:#00C896;text-decoration:none;letter-spacing:0.08em;text-transform:uppercase;display:flex;align-items:center;gap:0.5rem;">VIEW PRODUCT →</a>
        </div>
      </div>
      <button id="quiz-reset" type="button" style="font-family:'Space Grotesk',sans-serif;font-size:0.78rem;font-weight:600;color:#8B949E;background:none;border:none;cursor:pointer;letter-spacing:0.08em;text-transform:uppercase;margin-top:1.25rem;padding:0;transition:color 0.25s;">
        ← START AGAIN
      </button>
    </div>
  </div>
</section>

<script is:inline>
(function () {
  document.addEventListener('DOMContentLoaded', function () {

    var answers = { feel: '', experience: '', level: '' };

    /* Product map */
    var products = {
      'EMBER DROPS':   { name: 'EMBER DROPS',           type: 'Full Spectrum CBD:THC 4:1', desc: 'Perfect for first-timers seeking calm without intensity. Sub-lingual tincture, precise dosing, gentle onset.', price: 'R380 / 30ml' },
      'WEDDING CAKE':  { name: 'WEDDING CAKE',           type: 'Indica Flower',             desc: 'A deeply relaxing cultivar with vanilla and earth notes. Body-forward, ideal for evenings and recovery.', price: 'R220 / 3.5g' },
      'DURBAN POISON': { name: 'DURBAN POISON',          type: 'Sativa Flower',             desc: "South Africa's legendary landrace sativa. Uplifting, clear-headed, creative energy. The classic choice.", price: 'R180 / 3.5g' },
      'GOLDEN HOUR':   { name: 'GOLDEN HOUR',            type: 'Hybrid Live Resin Vape',    desc: 'Premium live resin hybrid for creative minds. Tropical fruit notes, balanced mind and body experience.', price: 'R350 / 1g' },
      'DARK FOREST':   { name: 'DARK FOREST CHOCOLATE', type: '72% Dark · 100mg THC',      desc: "Artisan 72% dark chocolate, 100mg THC. Slow burn, long lasting. The connoisseur's edible.", price: 'R120 / bar' },
    };

    function getRecommendation() {
      var f = answers.feel, e = answers.experience, l = answers.level;
      if (f === 'RELAXED'   && e === 'MIND' && l === 'FIRST TIME') return 'EMBER DROPS';
      if (f === 'RELAXED')                                           return 'WEDDING CAKE';
      if (f === 'CREATIVE'  && e === 'MIND')                        return 'DURBAN POISON';
      if (f === 'CREATIVE')                                          return 'GOLDEN HOUR';
      if (f === 'ENERGISED')                                         return 'DURBAN POISON';
      if (f === 'SLEEPY')                                            return 'WEDDING CAKE';
      return 'DARK FOREST';
    }

    function showStep(id) {
      var el = document.getElementById(id);
      if (el) el.classList.add('visible');
    }

    function showResult() {
      var key = getRecommendation();
      var p   = products[key];
      if (!p) return;
      document.getElementById('result-name').textContent  = p.name;
      document.getElementById('result-type').textContent  = p.type;
      document.getElementById('result-desc').textContent  = p.desc;
      document.getElementById('result-price').textContent = p.price;
      document.getElementById('quiz-result').classList.add('visible');
    }

    document.querySelectorAll('.quiz-tile').forEach(function (tile) {
      tile.addEventListener('click', function () {
        var step = this.dataset.step;
        var val  = this.dataset.val;

        /* Deselect siblings */
        var parent = this.parentElement;
        parent.querySelectorAll('.quiz-tile').forEach(function (t) { t.classList.remove('selected'); });
        this.classList.add('selected');

        if (step === '1') {
          answers.feel = val;
          showStep('step-2');
        } else if (step === '2') {
          answers.experience = val;
          showStep('step-3');
        } else if (step === '3') {
          answers.level = val;
          setTimeout(showResult, 200);
        }
      });
    });

    /* Reset */
    var resetBtn = document.getElementById('quiz-reset');
    if (resetBtn) {
      resetBtn.addEventListener('click', function () {
        answers = { feel: '', experience: '', level: '' };
        document.querySelectorAll('.quiz-tile').forEach(function (t) { t.classList.remove('selected'); });
        document.getElementById('step-2').classList.remove('visible');
        document.getElementById('step-3').classList.remove('visible');
        document.getElementById('quiz-result').classList.remove('visible');
      });
    }

  });
})();
</script>
