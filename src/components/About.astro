---
// Section 4 — Sticky split scroll: green left panel stays, right side scrolls
---

<section id="about" class="about-container" style="position:relative;">

  <!-- LEFT — sticky green panel -->
  <div class="about-left">
    <!-- Noise texture on green -->
    <div style="position:absolute;inset:0;background:repeating-linear-gradient(0deg,transparent,transparent 3px,rgba(0,0,0,0.03) 3px,rgba(0,0,0,0.03) 4px);pointer-events:none;" aria-hidden="true"></div>

    <!-- Vertical "VERDANT" text -->
    <div class="about-brand-block" style="position:relative;z-index:2;display:flex;flex-direction:column;align-items:center;gap:1.5rem;">
      <div class="about-brand-text" style="font-family:'Space Grotesk',sans-serif;font-size:clamp(3rem,5vw,6rem);font-weight:700;color:#06080A;letter-spacing:-0.03em;writing-mode:vertical-rl;transform:rotate(180deg);line-height:1;">
        VERDANT
      </div>
      <div style="font-family:'Space Grotesk',sans-serif;font-size:0.7rem;font-weight:700;letter-spacing:0.18em;text-transform:uppercase;color:rgba(6,8,10,0.55);">
        EST. 2024
      </div>
      <div style="width:1px;height:40px;background:rgba(6,8,10,0.25);"></div>
      <div style="font-family:'Space Grotesk',sans-serif;font-size:2rem;font-weight:700;color:#06080A;letter-spacing:-0.03em;">
        PMB
      </div>
    </div>
  </div>

  <!-- RIGHT — scrolling content -->
  <div class="about-right">

    <!-- Block 1 -->
    <div class="about-block" data-animate>
      <p style="font-family:'Space Grotesk',sans-serif;font-size:0.68rem;font-weight:700;letter-spacing:0.18em;color:#00C896;text-transform:uppercase;margin-bottom:1.5rem;">
        WHY VERDANT
      </p>
      <h2 style="font-family:'Space Grotesk',sans-serif;font-size:clamp(2rem,5vw,4rem);font-weight:700;color:#FFFFFF;letter-spacing:-0.04em;line-height:1.05;margin-bottom:2rem;">
        We got tired<br />of the back room.
      </h2>
      <p style="font-family:'Space Grotesk',sans-serif;font-size:1rem;color:#8B949E;line-height:1.8;max-width:520px;">
        Cannabis has been sold in South Africa like something to be ashamed of. Hidden. Rushed. Unverified. We built Verdant because PMB deserves better. A proper dispensary. A knowledgeable team. Products you can trust.
      </p>
    </div>

    <!-- Block 2 -->
    <div class="about-block" data-animate>
      <p style="font-family:'Space Grotesk',sans-serif;font-size:0.68rem;font-weight:700;letter-spacing:0.18em;color:#00C896;text-transform:uppercase;margin-bottom:1.5rem;">
        OUR SOURCING
      </p>
      <h2 style="font-family:'Space Grotesk',sans-serif;font-size:clamp(2rem,5vw,4rem);font-weight:700;color:#FFFFFF;letter-spacing:-0.04em;line-height:1.05;margin-bottom:2rem;">
        Only licensed.<br />Only tested.
      </h2>
      <p style="font-family:'Space Grotesk',sans-serif;font-size:1rem;color:#8B949E;line-height:1.8;max-width:520px;">
        Every product at Verdant comes from a licensed South African cultivator. Every batch is lab tested. We know exactly what is in every product we sell — and so will you. That transparency is non-negotiable.
      </p>
    </div>

    <!-- Block 3 -->
    <div class="about-block" data-animate>
      <p style="font-family:'Space Grotesk',sans-serif;font-size:0.68rem;font-weight:700;letter-spacing:0.18em;color:#00C896;text-transform:uppercase;margin-bottom:1.5rem;">
        OUR TEAM
      </p>
      <h2 style="font-family:'Space Grotesk',sans-serif;font-size:clamp(2rem,5vw,4rem);font-weight:700;color:#FFFFFF;letter-spacing:-0.04em;line-height:1.05;margin-bottom:2rem;">
        Budtenders<br />not salespeople.
      </h2>
      <p style="font-family:'Space Grotesk',sans-serif;font-size:1rem;color:#8B949E;line-height:1.8;max-width:520px;">
        Our staff are trained cannabis specialists. They will never push you toward the most expensive product. They will ask the right questions, listen carefully, and help you find the right product for you — every time.
      </p>
    </div>

    <!-- Block 4 — Stats -->
    <div class="about-block" data-animate style="border-bottom:none;">
      <p style="font-family:'Space Grotesk',sans-serif;font-size:0.68rem;font-weight:700;letter-spacing:0.18em;color:#00C896;text-transform:uppercase;margin-bottom:3rem;">
        BY THE NUMBERS
      </p>
      <div style="display:flex;flex-direction:column;gap:3rem;">

        <div>
          <div style="display:flex;align-items:baseline;gap:0.5rem;">
            <span class="count-stat text-glow-green" data-target="100" data-suffix="%" style="font-family:'Space Grotesk',sans-serif;font-size:clamp(4rem,10vw,8rem);font-weight:700;color:#00C896;letter-spacing:-0.04em;line-height:1;">0</span>
            <span class="text-glow-green" style="font-family:'Space Grotesk',sans-serif;font-size:clamp(4rem,10vw,8rem);font-weight:700;color:#00C896;letter-spacing:-0.04em;line-height:1;" aria-hidden="true">%</span>
          </div>
          <p style="font-family:'Space Grotesk',sans-serif;font-size:0.85rem;color:#8B949E;letter-spacing:0.04em;text-transform:uppercase;margin-top:0.5rem;">Lab Tested Products</p>
        </div>

        <div>
          <div style="font-family:'Space Grotesk',sans-serif;font-size:clamp(4rem,10vw,8rem);font-weight:700;color:#FFFFFF;letter-spacing:-0.04em;line-height:1;">SA</div>
          <p style="font-family:'Space Grotesk',sans-serif;font-size:0.85rem;color:#8B949E;letter-spacing:0.04em;text-transform:uppercase;margin-top:0.5rem;">Grown and Sourced Locally</p>
        </div>

        <div>
          <div class="text-glow-green" style="font-family:'Space Grotesk',sans-serif;font-size:clamp(4rem,10vw,8rem);font-weight:700;color:#00C896;letter-spacing:-0.04em;line-height:1;">18+</div>
          <p style="font-family:'Space Grotesk',sans-serif;font-size:0.85rem;color:#8B949E;letter-spacing:0.04em;text-transform:uppercase;margin-top:0.5rem;">Strictly Enforced Always</p>
        </div>

      </div>
    </div>

  </div>
</section>

<style>
  @media (max-width: 768px) {
    .about-brand-block { gap: 0.75rem !important; }
    .about-brand-text {
      writing-mode: horizontal-tb !important;
      transform: none !important;
      font-size: clamp(2rem, 9vw, 3rem) !important;
    }
  }
</style>

<script is:inline>
(function () {
  document.addEventListener('DOMContentLoaded', function () {

    /* Counter animation on scroll into view */
    var stats = document.querySelectorAll('.count-stat');
    if (!stats.length) return;

    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (!e.isIntersecting) return;
        var el      = e.target;
        var target  = parseInt(el.dataset.target, 10);
        var suffix  = el.dataset.suffix || '';
        var start   = 0;
        var dur     = 1800;
        var step    = 16;
        var inc     = target / (dur / step);

        var timer = setInterval(function () {
          start += inc;
          if (start >= target) {
            el.textContent = target;
            clearInterval(timer);
          } else {
            el.textContent = Math.floor(start);
          }
        }, step);

        io.unobserve(el);
      });
    }, { threshold: 0.5 });

    stats.forEach(function (el) { io.observe(el); });
  });
})();
</script>
