---
// Section 5 — About: Asymmetric two-column layout
---

<section id="about" style="background-color:#0D140D;display:grid;grid-template-columns:45fr 55fr;min-height:720px;" class="about-section">

  <!-- LEFT — Deep green botanical panel -->
  <div style="background-color:#1B4332;position:relative;overflow:hidden;display:flex;align-items:center;justify-content:center;padding:5rem 3rem;">

    <!-- Full-panel botanical watermark -->
    <div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;opacity:0.12;" aria-hidden="true">
      <svg viewBox="0 0 120 160" fill="none" xmlns="http://www.w3.org/2000/svg" width="85%" height="auto">
        <g stroke="#C9A84C" stroke-width="0.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M60 155 C60 155 58 133 60 115"/>
          <path d="M60 115 C55 95 48 75 46 52 C50 62 55 78 57 88 C54 72 53 48 60 30 C67 48 66 72 63 88 C65 78 70 62 74 52 C72 75 65 95 60 115Z"/>
          <path d="M56 100 C48 92 32 86 18 80 C27 86 40 92 52 100Z"/>
          <path d="M64 100 C72 92 88 86 102 80 C93 86 80 92 68 100Z"/>
          <path d="M53 108 C43 102 26 104 12 101 C22 106 36 108 50 110Z"/>
          <path d="M67 108 C77 102 94 104 108 101 C98 106 84 108 70 110Z"/>
          <path d="M52 112 C42 110 28 115 16 115 C25 118 38 117 54 115Z"/>
          <path d="M68 112 C78 110 92 115 104 115 C95 118 82 117 66 115Z"/>
        </g>
      </svg>
    </div>

    <!-- Radial glow -->
    <div style="position:absolute;inset:0;background:radial-gradient(ellipse at 50% 50%, rgba(201,168,76,0.07) 0%, transparent 65%);pointer-events:none;" aria-hidden="true"></div>

    <!-- Center brand mark -->
    <div style="text-align:center;position:relative;z-index:2;">
      <!-- Botanical icon -->
      <div style="margin-bottom:2rem;display:flex;justify-content:center;" aria-hidden="true">
        <svg viewBox="0 0 120 160" fill="none" xmlns="http://www.w3.org/2000/svg" width="48" height="64">
          <g stroke="#C9A84C" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M60 155 C60 155 58 133 60 115"/>
            <path d="M60 115 C55 95 48 75 46 52 C50 62 55 78 57 88 C54 72 53 48 60 30 C67 48 66 72 63 88 C65 78 70 62 74 52 C72 75 65 95 60 115Z"/>
            <path d="M56 100 C48 92 32 86 18 80 C27 86 40 92 52 100Z"/>
            <path d="M64 100 C72 92 88 86 102 80 C93 86 80 92 68 100Z"/>
            <path d="M53 108 C43 102 26 104 12 101 C22 106 36 108 50 110Z"/>
            <path d="M67 108 C77 102 94 104 108 101 C98 106 84 108 70 110Z"/>
          </g>
        </svg>
      </div>

      <!-- Brand name -->
      <div style="font-family:'Cormorant Garamond',Georgia,serif;font-size:clamp(3.5rem,6vw,5.5rem);font-style:italic;font-weight:400;color:#C9A84C;letter-spacing:0.04em;line-height:1;margin-bottom:1rem;">
        VERDANT
      </div>

      <!-- Gold line -->
      <div style="width:40px;height:1px;background:#C9A84C;margin:0 auto 1rem;"></div>

      <!-- Metadata -->
      <p style="font-family:'Jost',sans-serif;font-size:0.72rem;color:rgba(245,240,232,0.55);letter-spacing:0.14em;text-transform:uppercase;margin:0 0 0.35rem;">Est. 2024</p>
      <p style="font-family:'Jost',sans-serif;font-size:0.72rem;color:rgba(157,184,160,0.6);letter-spacing:0.1em;text-transform:uppercase;margin:0;">Pietermaritzburg, KZN</p>
    </div>
  </div>

  <!-- RIGHT — Story content -->
  <div class="grain" style="background-color:#0D140D;padding:6rem 5rem 5rem;display:flex;flex-direction:column;justify-content:center;">

    <div data-animate>
      <p class="gold-label" style="margin-bottom:1.5rem;">Our Story</p>

      <h2 style="font-family:'Cormorant Garamond',Georgia,serif;font-size:clamp(2rem,4vw,3.25rem);font-style:italic;font-weight:400;color:#F5F0E8;margin:0 0 0.5rem;line-height:1.1;">
        PMB's first premium cannabis experience
      </h2>
      <div style="width:44px;height:2px;background:#C9A84C;margin-bottom:2.5rem;"></div>

      <div style="font-family:'Jost',sans-serif;font-size:0.9375rem;color:#9DB8A0;line-height:1.85;display:flex;flex-direction:column;gap:1.25rem;margin-bottom:3rem;">
        <p style="margin:0;">
          Verdant was born from a simple belief — that cannabis deserves the same respect and craftsmanship as fine wine, single malt whisky or artisanal coffee.
        </p>
        <p style="margin:0;">
          For too long the cannabis industry in South Africa has been defined by back rooms and brown paper bags. We believe it deserves better. Our customers deserve better.
        </p>
        <p style="margin:0;">
          Every product at Verdant is sourced from licensed South African cultivators who share our obsession with quality. We test everything. We stand behind everything. And we will never stock anything we would not use ourselves.
        </p>
        <p style="margin:0;font-style:italic;color:#F5F0E8;">
          Pietermaritzburg — we are glad you are ready for this.
        </p>
      </div>

      <!-- Stats row -->
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;">
        <div class="stat-box">
          <div style="font-family:'Cormorant Garamond',Georgia,serif;font-size:2rem;font-style:italic;color:#C9A84C;line-height:1;margin-bottom:0.25rem;">100%</div>
          <div style="font-family:'Jost',sans-serif;font-size:0.65rem;color:#74C69D;letter-spacing:0.1em;text-transform:uppercase;">Lab Tested</div>
        </div>
        <div class="stat-box">
          <div style="font-family:'Cormorant Garamond',Georgia,serif;font-size:1.6rem;font-style:italic;color:#C9A84C;line-height:1;margin-bottom:0.25rem;">SA Grown</div>
          <div style="font-family:'Jost',sans-serif;font-size:0.65rem;color:#74C69D;letter-spacing:0.1em;text-transform:uppercase;">Local Cultivators Only</div>
        </div>
        <div class="stat-box">
          <div style="font-family:'Cormorant Garamond',Georgia,serif;font-size:2rem;font-style:italic;color:#C9A84C;line-height:1;margin-bottom:0.25rem;">18+</div>
          <div style="font-family:'Jost',sans-serif;font-size:0.65rem;color:#74C69D;letter-spacing:0.1em;text-transform:uppercase;">Strictly Enforced</div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @media (max-width: 900px) {
    .about-section {
      grid-template-columns: 1fr !important;
    }
  }
  @media (max-width: 768px) {
    .about-section > div:last-child {
      padding: 4rem 2rem !important;
    }
  }
</style>
