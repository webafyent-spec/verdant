---
// Section 8 — Terminal typewriter visit section with scanlines
---

<section id="visit" class="scanlines" style="background:#06080A;padding:8rem 0;position:relative;">

  <div style="max-width:900px;margin:0 auto;padding:0 2rem;position:relative;z-index:3;">

    <!-- Section label -->
    <div data-animate style="margin-bottom:3rem;">
      <p style="font-family:'Space Grotesk',sans-serif;font-size:0.68rem;font-weight:700;letter-spacing:0.18em;color:#00C896;text-transform:uppercase;margin-bottom:1rem;">Visit Us</p>
      <h2 style="font-family:'Space Grotesk',sans-serif;font-size:clamp(2rem,5vw,3.5rem);font-weight:700;color:#FFFFFF;letter-spacing:-0.04em;line-height:1;">
        We are open.<br />Come in.
      </h2>
    </div>

    <!-- Terminal window -->
    <div style="border:1px solid rgba(0,200,150,0.3);background:#0D1117;padding:2rem 2.5rem;position:relative;overflow:hidden;" id="terminal-window">

      <!-- Terminal header bar -->
      <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:1.5rem;padding-bottom:1rem;border-bottom:1px solid rgba(0,200,150,0.15);">
        <div style="width:10px;height:10px;border-radius:50%;background:#ff5f57;"></div>
        <div style="width:10px;height:10px;border-radius:50%;background:#febc2e;"></div>
        <div style="width:10px;height:10px;border-radius:50%;background:#28c840;"></div>
        <span style="font-family:'Space Grotesk',sans-serif;font-size:0.65rem;color:rgba(0,200,150,0.4);letter-spacing:0.1em;margin-left:0.75rem;">verdant-terminal — bash</span>
      </div>

      <!-- Terminal body where text is typed -->
      <div class="terminal-body" id="terminal-body" aria-live="polite" aria-label="Verdant dispensary information"></div>

      <!-- Cursor -->
      <span class="blink-cursor" id="terminal-cursor" style="display:none;">█</span>
    </div>

    <!-- Terminal action buttons -->
    <div style="display:flex;flex-wrap:wrap;gap:1rem;margin-top:2rem;" data-animate data-delay="2">
      <a href="https://maps.google.com/?q=18+Church+Street+Pietermaritzburg" target="_blank" rel="noopener noreferrer" class="terminal-btn">[GET DIRECTIONS]</a>
      <a href="tel:0333420180" class="terminal-btn">[CALL US]</a>
      <a href="mailto:hello@verdant.co.za" class="terminal-btn">[EMAIL]</a>
    </div>

  </div>
</section>

<script is:inline>
(function () {
  document.addEventListener('DOMContentLoaded', function () {

    var terminal = document.getElementById('terminal-body');
    var cursor   = document.getElementById('terminal-cursor');
    if (!terminal) return;

    var lines = [
      '> VERDANT DISPENSARY PMB',
      '> ───────────────────────',
      '> LOCATION: 18 CHURCH STREET',
      '> PIETERMARITZBURG  3201',
      '> ───────────────────────',
      '> STATUS: OPEN',
      '> MON-SAT: 09:00 - 19:00',
      '> SUN:     10:00 - 17:00',
      '> ───────────────────────',
      '> PHONE: 033 342 0180',
      '> EMAIL: HELLO@VERDANT.CO.ZA',
      '> ───────────────────────',
      '> REQUIREMENTS:',
      '> VALID ID · 18+ STRICTLY',
      '> ───────────────────────',
      '> PRODUCTS IN STOCK: 19',
      '> WALK-INS: WELCOME',
      '> ───────────────────────',
      '> READY TO VISIT? [Y/N]: _',
    ];

    var started = false;

    function startTyping() {
      if (started) return;
      started = true;

      var lineIdx = 0;
      var charIdx = 0;
      var currentLineEl = null;

      function nextChar() {
        if (lineIdx >= lines.length) {
          if (cursor) cursor.style.display = 'inline';
          return;
        }

        if (charIdx === 0) {
          currentLineEl = document.createElement('span');
          currentLineEl.className = 'terminal-line';
          terminal.appendChild(currentLineEl);
        }

        var line = lines[lineIdx];
        currentLineEl.textContent = line.slice(0, charIdx + 1);
        charIdx++;

        if (charIdx >= line.length) {
          lineIdx++;
          charIdx = 0;
          setTimeout(nextChar, lineIdx === 1 || line.includes('───') ? 60 : 80);
        } else {
          var speed = line.includes('───') ? 10 : 22;
          setTimeout(nextChar, speed);
        }
      }

      nextChar();
    }

    /* Start on scroll into view */
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) { startTyping(); io.unobserve(e.target); }
        });
      }, { threshold: 0.3 });
      var tw = document.getElementById('terminal-window');
      if (tw) io.observe(tw);
    } else {
      startTyping();
    }

  });
})();
</script>
